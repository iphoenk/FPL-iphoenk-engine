        {
          "id": "premier_league_clubs",
          "url": "https://query.wikidata.org/sparql",
          "params": {
            "format": "json",
            "query": "SELECT ?club ?clubLabel (SAMPLE(?website) AS ?website) WHERE { ?club wdt:P118 wd:Q9448 . ?club wdt:P31/wdt:P279* wd:Q476028 . OPTIONAL { ?club wdt:P856 ?website . } SERVICE wikibase:label { bd:serviceParam wikibase:language \"en\". } } GROUP BY ?club ?clubLabel ORDER BY ?clubLabel"
          },
          "expect": "json",
          "validation": {
            "min_body_bytes": 100
          }
        }
      ],
      "access": {
        "cost": "ZERO",
        "account_required": false,
        "login_required": false,
        "private_api_key_required": false,
        "private_token_required": false,
        "shared_public_key": false
      },
      "notes": "Public no-auth SPARQL corroboration only. Query scope is constrained to association-football-club entities and grouped to one row per Wikidata club QID; P118 is not treated as proof of current-season membership. Results never supersede Official FPL identity and never authorize fuzzy runtime joins.",
