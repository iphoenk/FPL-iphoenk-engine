{
  "version": 7,
  "module_policy": {
    "minimum_registered_modules": 35,
    "required_truth_modules": ["rules","source_authority","public_api","official_authenticated","event_context","identity","phase_state","squad","finance","team_service","live_scoring"],
    "required_intelligence_modules": ["price_trajectory","xmins_v2","role_intelligence","team_strength","projection","prediction_evaluation","calibration_store","challenger_scorecard","package_optimizer"],
    "required_decision_modules": ["projection_index","package_optimizer","lineup_optimizer","decision_trace","dss_core","dss_extensions"],
    "required_framework_modules": ["gate0","enhancement_layers","framework_health"],
    "required_governance_modules": ["performance","persistence","degraded_mode","cluster_health","runner","service_runtime"],
    "active_statuses": ["ACTIVE", "ACTIVE_ALPHA"]
  },
  "service_policy": {
    "mandatory": true,
    "minimum_services": 9,
    "required_services": ["orchestrator","ingestion","truth","price","prediction","evaluation","decision","governance","snapshot"],
    "require_unique_ports": true,
    "require_acyclic_dependencies": true,
    "require_exactly_one_service_owner_per_registered_module": true,
    "require_independent_process": true,
    "require_health_endpoint": true,
    "require_versioned_contract": true,
    "require_deployment_manifest": "deploy/v5/docker-compose.yml"
  },
  "convergence": {
    "production_baseline": "v3.10.0",
    "p0_capabilities_required": ["P0-1_prediction_calibration_backtest","P0-2_xmins_role_v2","P0-3_team_strength_fixture_probability","P0-4_multi_horizon_package_optimizer","P0-5_external_challenger_scorecard"],
    "decision_bridge_only_forbidden": true,
    "native_lineup_required": true,
    "decision_trace_required": true,
    "gate0_full_registry_required": true,
    "analysis_parallel_routes_required": ["evaluation_build","decision_prepare","gate0_preflight"],
    "v4_prediction_bridge_must_not_be_authority": true,
    "governance_service_must_block_go_until_postflight_gate0": true,
    "degraded_context_must_block_unqualified_go": true,
    "critical_service_failure_must_fail_closed": true,
    "cluster_health_must_be_on_demand_only": true
  },
  "production": {"promotion_must_remain_locked_during_alpha": true},
  "architecture": {"require_entrypoint": true,"require_config": true,"require_adjustment_surface": true,"require_microservices": true}
}
