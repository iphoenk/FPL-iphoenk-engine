  "schema_version": 3,
  "registry": "RUNTIME_PUBLISH_REGISTRY_V1",
  "policy": {
    "runtime_branch_is_current_state_not_git_history_database": true,
    "publish_only_declared_paths": true,
    "history_jsonl_and_gw_archives_are_not_published": true,
    "raw_authenticated_payloads_are_forbidden": true,
