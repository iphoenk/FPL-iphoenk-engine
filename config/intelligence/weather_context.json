{
  "schema_version": 1,
  "model_id": "weather_context_observational_v1",
  "provider_source_id": "open_meteo",
  "venue_registry": "config/venues/premier_league_2026_27.json",
  "api": {
    "forecast_url": "https://api.open-meteo.com/v1/forecast",
    "request_timeout_seconds": 10,
    "max_parallel_requests": 4,
    "hourly_fields": ["temperature_2m", "precipitation_probability", "precipitation", "wind_speed_10m", "wind_gusts_10m", "weather_code"]
  },
  "forecast_policy": {
    "max_horizon_days": 7,
    "retain_observations_per_fixture": 8,
    "post_match_retention_hours": 48,
    "freshness_hours": {"HIGH": 6, "MEDIUM": 24, "LOW": 72},
    "confidence_by_horizon_days": {"0": "HIGH", "1": "HIGH", "2": "MEDIUM", "3": "MEDIUM", "4": "LOW", "5": "LOW", "6": "LOW", "7": "LOW"}
  },
  "severity": {
    "NOTABLE": {"wind_speed_kmh": 22, "wind_gust_kmh": 35, "precipitation_mm_h": 2.0, "cold_c": 5, "heat_c": 27},
    "ADVERSE": {"wind_speed_kmh": 30, "wind_gust_kmh": 45, "precipitation_mm_h": 4.0, "cold_c": 3, "heat_c": 30},
    "EXTREME": {"wind_speed_kmh": 45, "wind_gust_kmh": 65, "precipitation_mm_h": 8.0, "cold_c": 0, "heat_c": 35}
  },
  "governance": {
    "advisory_only": true,
    "may_directly_change_xpts": false,
    "may_directly_change_captaincy": false,
    "may_directly_change_starting_xi": false,
    "may_directly_change_transfer_decision": false,
    "may_directly_change_watchlist_membership": false,
    "rain_probability_is_not_rain_intensity": true,
    "post_match_attribution_label": "POSSIBLE_CONTRIBUTING_FACTOR",
    "causal_claim_requires_calibrated_evidence": true,
    "alternative_explanations_required": ["opponent_strength", "tactical_change", "game_state", "red_cards", "injury", "rotation", "role_change", "venue", "sample_noise"]
  }
}
