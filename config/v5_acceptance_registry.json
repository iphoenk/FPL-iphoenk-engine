{
  "version": 2,
  "module_policy": {
    "minimum_registered_modules": 22,
    "required_truth_modules": [
      "rules",
      "source_authority",
      "public_api",
      "official_authenticated",
      "event_context",
      "identity",
      "phase_state",
      "squad",
      "finance",
      "team_service",
      "live_scoring"
    ],
    "required_governance_modules": ["performance", "persistence", "runner", "service_runtime"],
    "active_statuses": ["ACTIVE", "ACTIVE_ALPHA"]
  },
  "service_policy": {
    "mandatory": true,
    "minimum_services": 7,
    "required_services": ["orchestrator", "ingestion", "truth", "price", "prediction", "decision", "snapshot"],
    "require_unique_ports": true,
    "require_acyclic_dependencies": true,
    "require_exactly_one_service_owner_per_registered_module": true,
    "require_independent_process": true,
    "require_health_endpoint": true,
    "require_versioned_contract": true,
    "require_deployment_manifest": "deploy/v5/docker-compose.yml"
  },
  "production": {
    "promotion_must_remain_locked_during_alpha": true
  },
  "architecture": {
    "require_entrypoint": true,
    "require_config": true,
    "require_adjustment_surface": true,
    "require_microservices": true
  }
}
