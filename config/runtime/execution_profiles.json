{
  "schema_version": 5,
  "registry": "RUNTIME_EXECUTION_PROFILES_V1",
  "policy": {
    "reuse_requires_all_declared_service_artifacts": true,
    "stale_or_missing_reuse_falls_back_to_refresh": true,
    "reused_service_counts_as_dependency_complete": true,
    "reused_service_latest_state_is_carried_forward": true,
    "fast_profile_must_preserve_decision_and_artifact_contracts": true,
    "profile_does_not_change_football_model_formulas": true,
    "reuse_freshness_uses_logical_artifact_time_not_hydration_mtime": true,
    "semantic_reuse_requires_current_input_signature_match": true,
    "semantic_reuse_requires_same_engine_version": true,
    "semantic_reuse_requires_output_hash_match": true,
    "semantic_reuse_manifest_is_separate_from_performance_telemetry": true,
    "cross_service_mutated_artifacts_are_not_semantically_reused_until_ownership_is_single": true,
    "fast_command_bundles_preserve_logical_service_artifact_contracts": true,
    "rec41_player_feature_migration_fence_active": false
  },
  "profiles": {
    "fast_decision": {
      "description": "Low-latency decision regeneration. Fresh Official truth and market pressure still run. Deterministic model/governance products reuse only validated logical age, exact semantic signatures and unchanged output hashes. Cross-service report mutations are regenerated until their artifact ownership is consolidated.",
      "max_parallel_services": 4,
      "reuse_services": {
        "advanced_stats": {"mode":"logical_age","max_age_seconds":21600},
        "historical_prior": {"mode":"logical_age","max_age_seconds":86400},
        "source_layer": {"mode":"logical_age","max_age_seconds":1800},
        "official_detail": {"mode":"logical_age","max_age_seconds":3600},
        "prediction": {
          "mode":"semantic_signature","max_age_seconds":21600,
          "signature_inputs":["official_snapshot.json","team.json","prior_season.json","player_features.json"],
          "signature_config_files":["config/intelligence/projection.json","config/intelligence/package_optimizer.json","config/intelligence/xmins_v2.json","config/intelligence/team_strength.json"]
        },
        "prediction_evaluation": {
          "mode":"semantic_signature","max_age_seconds":1800,
          "signature_inputs":["official_snapshot.json","projections.json","prediction_ledger.json"],
          "signature_config_files":["config/intelligence/prediction_evaluation.json"]
        },
        "lineup_governance": {
          "mode":"semantic_signature","max_age_seconds":21600,
          "signature_inputs":["team.json","chips.json","projections.json","package_optimizer.json"],
          "signature_config_files":["config/intelligence/lineup_governance.json","config/manual_lineup_override.json","config/locked_squad.json"]
        },
        "challenger": {
          "mode":"semantic_signature","max_age_seconds":1800,
          "signature_inputs":["projections.json","prediction_ledger.json","challenger_observations.json","source_health.json"],
          "signature_config_files":["config/intelligence/challenger_registry.json"]
        },
        "governance": {
          "mode":"semantic_signature","max_age_seconds":1800,
          "artifacts":["framework_health.json","dss_operational_evidence.json"],
          "signature_inputs":["team.json","chips.json","projections.json","prediction_quality.json","lineup_decision.json","package_decision.json","prediction_accuracy.json","source_health.json","challenger_scorecard.json","price_alerts.json","rules_compliance.json"],
          "signature_config_files":["config/dss_core_registry.json","config/dss_extension_registry.json","config/enhancement_layers_registry.json","config/gate0_registry.json","config/intelligence/dss_operationalization.json","config/intelligence/capability_master_registry.json"]
        },
        "watchlist": {
          "mode":"semantic_signature","max_age_seconds":1800,
          "signature_inputs":["team.json","projections.json","package_optimizer.json","prices.json","price_alerts.json","framework_health.json","dss_operational_evidence.json"],
          "signature_config_files":["config/intelligence/dss_watchlist.json","config/intelligence/capability_master_registry.json"]
        }
      },
      "command_bundles": {
        "governance": "src.engines.governance_bundle",
        "watchlist": "src.engines.watchlist_bundle",
        "reporting": "src.engines.reporting_bundle",
        "report_materializer": "src.engines.report_serving_bundle"
      }
    },
    "live": {
      "description": "Low-latency live path. Long-lived enrichment/detail may be reused by logical age, while event-sensitive downstream outputs regenerate unless an exact safe semantic contract is explicitly declared.",
      "max_parallel_services": 4,
      "reuse_services": {
        "advanced_stats": {"mode":"logical_age","max_age_seconds":21600},
        "historical_prior": {"mode":"logical_age","max_age_seconds":86400},
        "source_layer": {"mode":"logical_age","max_age_seconds":900},
        "official_detail": {"mode":"logical_age","max_age_seconds":1800},
        "prediction": {
          "mode":"semantic_signature","max_age_seconds":3600,
          "signature_inputs":["official_snapshot.json","team.json","prior_season.json","player_features.json"],
          "signature_config_files":["config/intelligence/projection.json","config/intelligence/package_optimizer.json","config/intelligence/xmins_v2.json","config/intelligence/team_strength.json"]
        }
      },
      "command_bundles": {
        "governance": "src.engines.governance_bundle",
        "watchlist": "src.engines.watchlist_bundle",
        "reporting": "src.engines.reporting_bundle",
        "report_materializer": "src.engines.report_serving_bundle"
      }
    },
    "full_refresh": {
      "description": "Complete source, enrichment, detail, model, governance and report refresh using the conservative unbundled acceptance path.",
      "max_parallel_services": 3,
      "reuse_services": {},
      "command_bundles": {}
    },
    "deep_stats": {
      "description": "Complete refresh including optional deep advanced-stat datasets using the conservative unbundled acceptance path.",
      "max_parallel_services": 2,
      "reuse_services": {},
      "command_bundles": {}
    }
  }
}
