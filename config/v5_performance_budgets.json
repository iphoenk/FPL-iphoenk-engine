{
  "version": 9,
  "mode": "advanced_beta",
  "policy": {
    "measure_wall_clock": true,
    "measure_network_calls": true,
    "measure_file_reads": true,
    "measure_service_compute": true,
    "measure_service_round_trip": true,
    "measure_transport_overhead": true,
    "measure_refresh_plane_end_to_end": true,
    "measure_hot_path_end_to_end": true,
    "block_unreviewed_regression": true,
    "single_pass_first": true,
    "hot_path_target_is_advisory_until_canary": false,
    "subsecond_runtime_is_release_blocking": true,
    "subsecond_sla_applies_to_user_facing_hot_path": true,
    "refresh_plane_is_precomputation_not_user_latency": true,
    "quality_may_not_be_reduced_to_meet_runtime": true,
    "optimizer_cold_and_steady_state_must_be_measured_separately": true,
    "notes": "V5 user-facing decision/report requests must complete below 1 second. The enforced hot-path hard limit is 0.95s with 0.05s operating margin. Heavy Official/provider refresh, full prediction, evaluation, optimizer and watchlist screening run on the governed refresh plane and materialize a fingerprinted decision bundle. Stale materialization fails closed and may never trigger hidden synchronous refresh. Analytical breadth and quality must not be reduced to meet the SLA."
  },
  "budgets": {
    "rules_registry_load_ms": 50,
    "single_player_projection_ms": 10,
    "projection_100_players_ms": 500,
    "decision_lineup_15_players_ms": 25,
    "projection_index_10000_lookups_ms": 50,
    "decision_package_optimizer_synthetic_ms": 300,
    "decision_package_optimizer_cold_synthetic_ms": 450,
    "decision_prepare_compute_ms": 300,
    "dss_registry_audit_ms": 25,
    "gate0_full_registry_ms": 25,
    "decision_finalize_ms": 50,
    "watchlist_700_players_ms": 75,
    "reporting_build_ms": 25,
    "decision_pipeline_soft_target_seconds": 0.85,
    "decision_pipeline_hard_limit_seconds": 0.95,
    "decision_pipeline_hot_target_seconds": 0.75,
    "hot_path_hot_target_seconds": 0.75,
    "hot_path_soft_target_seconds": 0.85,
    "hot_path_hard_limit_seconds": 0.95,
    "refresh_pipeline_observability_ceiling_seconds": 5.0,
    "internal_service_transport_overhead_soft_ms": 25,
    "internal_service_health_soft_ms": 75,
    "orchestrator_non_source_overhead_soft_ms": 450,
    "duplicate_source_fetches_per_run": 0,
    "duplicate_rules_file_reads_per_process": 0,
    "max_prediction_network_fixture_count": 5
  }
}
