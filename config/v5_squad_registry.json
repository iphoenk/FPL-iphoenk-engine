    "require_unique_elements": true,
    "require_exact_position_counts": true,
    "require_club_limit": true
  },
  "planning_override": {
    "enabled": true,
    "target_gw_required": true,
    "stale_target_behavior": "SKIP_USER_LOCK_AND_CONTINUE_AUTHORITY_CHAIN",
