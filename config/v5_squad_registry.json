{
  "version": 3,
  "locked_squad_config": "config/locked_squad.json",
  "validation": {
    "fail_closed": true,
    "identity_keys": ["element", "position", "expected_web_name", "expected_team"],
    "require_unique_elements": true,
    "require_exact_position_counts": true,
    "require_club_limit": true
  },
  "pre_deadline": {
    "default_authority": "user_capture",
    "fallback_authority": "official_public",
    "authenticated_official_role": "optional_private_enrichment",
    "authenticated_official_production_blocking": false,
    "user_capture_must_match_planning_gw": true,
    "stale_capture_must_not_mask_official_submitted": true
  },
  "reconciliation": {
    "enabled": true,
    "compare_by": "element_id",
    "submitted_becomes_baseline_after_deadline": true,
    "record_additions_removals": true
  }
}
