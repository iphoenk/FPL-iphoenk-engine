{
  "version": 8,
  "architecture": "bounded-context-microservices",
  "mandatory": true,
  "policy": {
    "monorepo_allowed": true,
    "independent_process_required": true,
    "independent_health_required": true,
    "versioned_contract_required": true,
    "business_authority_must_not_be_duplicated": true,
    "shared_code_scope": ["contracts", "transport", "observability", "config loader"],
    "prefer_fewer_domain_services_over_chatty_function_services": true,
    "parallelize_independent_calls": true,
    "service_timeouts_required": true,
    "circuit_breaker_ready": true,
    "module_ownership": "exactly_one_service"
  },
  "defaults": {
    "contract_version": "v1",
    "transport": "http-json",
    "health_path": "/health",
    "meta_path": "/meta",
    "invoke_path": "/v1/invoke/{operation}",
    "connect_timeout_ms": 400,
    "read_timeout_ms": 5000
  },
  "services": {
    "ingestion": {"port":8101,"bounded_context":"official-public-and-authenticated-ingestion","handler":"src.v5.services.ingestion:handle","owns_modules":["public_api","official_authenticated","source_authority"],"dependencies":[],"status":"ACTIVE_ALPHA","critical":true},
    "truth": {"port":8102,"bounded_context":"rules-phase-identity-squad-finance-live-truth","handler":"src.v5.services.truth:handle","owns_modules":["rules","event_context","identity","phase_state","squad","finance","team_service","live_scoring"],"dependencies":["ingestion"],"status":"ACTIVE_ALPHA","critical":true},
    "price": {"port":8103,"bounded_context":"price-trajectory-intelligence","handler":"src.v5.services.price:handle","owns_modules":["price_trajectory","price_service"],"dependencies":["ingestion","truth"],"status":"ACTIVE_ALPHA","critical":false},
    "prediction": {"port":8104,"bounded_context":"xmins-role-team-strength-and-projection-intelligence","handler":"src.v5.services.prediction:handle","owns_modules":["xmins_v2","role_intelligence","team_strength","projection"],"dependencies":["ingestion","truth"],"status":"ACTIVE_ALPHA","critical":true},
    "decision": {"port":8105,"bounded_context":"dss-lineup-decision-trace-and-multi-horizon-package-optimization","handler":"src.v5.services.decision:handle","owns_modules":["projection_index","package_optimizer","lineup_optimizer","decision_trace","dss_core","dss_extensions"],"dependencies":["truth","price","prediction","evaluation"],"status":"ACTIVE_ALPHA","critical":true},
    "snapshot": {"port":8106,"bounded_context":"persistence-snapshot-and-history","handler":"src.v5.services.snapshot:handle","owns_modules":["persistence"],"dependencies":[],"status":"ACTIVE_ALPHA","critical":true},
    "evaluation": {"port":8107,"bounded_context":"prediction-calibration-backtest-and-external-challengers","handler":"src.v5.services.evaluation:handle","owns_modules":["prediction_evaluation","calibration_store","challenger_scorecard"],"dependencies":["prediction","snapshot"],"status":"ACTIVE_ALPHA","critical":true},
    "governance": {"port":8108,"bounded_context":"gate0-framework-health-enhancements-and-final-governance","handler":"src.v5.services.governance:handle","owns_modules":["gate0","enhancement_layers","framework_health"],"dependencies":["truth","price","prediction","evaluation","decision"],"status":"ACTIVE_ALPHA","critical":true},
    "orchestrator": {"port":8100,"bounded_context":"workflow-orchestration-observability-and-degraded-mode-governance","handler":"src.v5.services.orchestrator:handle","owns_modules":["runner","performance","degraded_mode","service_runtime"],"dependencies":["ingestion","truth","price","prediction","evaluation","decision","governance","snapshot"],"status":"ACTIVE_ALPHA","critical":true}
  }
}
