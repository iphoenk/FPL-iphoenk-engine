  "contextual_feature_contract": {
    "contract_id": "P1_6_CONTEXTUAL_PLAYER_FIXTURE_V1",
    "model_owner": "V12_TACTICAL_ROLE",
    "required_output_fields": [
      "home_attack_context",
      "attacking_involvement_score",
      "role_security_score",
      "scoring_channel_vector",
      "scoring_channel_diversity",
      "tactical_role_fit",
      "fixture_suppression_raw",
      "role_resilience",
      "fixture_suppression_effective",
      "canonical_tactical_role_score"
    ],
    "scoring_channels": [
      "GOAL",
      "ASSIST",
      "SET_PIECE",
      "PENALTY",
      "DEFENSIVE_CONTRIBUTION",
      "CLEAN_SHEET",
      "BONUS"
    ],
    "dependency_groups": {
      "ATTACK_OPEN_PLAY": [
        "GOAL",
        "ASSIST"
      ],
      "DEAD_BALL": [
        "SET_PIECE",
        "PENALTY"
      ],
      "DEFENSIVE": [
        "DEFENSIVE_CONTRIBUTION",
        "CLEAN_SHEET"
      ],
      "BONUS": [
        "BONUS"
      ]
    },
    "formulas": {
      "bounded_ratio": "x/(x+reference), reference>0",
      "home_ratio_transform": "venue_ratio/(1+venue_ratio)",
      "involvement_shrinkage": "0.5 + reliability * (raw_involvement - 0.5)",
      "involvement_reliability": "evidence_minutes/(evidence_minutes + p1.3_rate_shrinkage_minutes)",
      "role_security": "arithmetic mean of available bounded P1.1/start-usage signals",
      "channel_diversity": "normalized Shannon entropy across dependency-group strengths multiplied by strongest group strength",
      "tactical_fit": "route-edge share shrunk toward 0.5 by evidence-confidence rank",
      "raw_fixture_suppression": "channel-exposure weighted max(0, 1 - 1/opponent_neutral_strength_index)",
      "role_resilience": "0.5 + evidence_completeness * (mean_available_context - 0.5)",
      "resilience_adjustment": "1/(1+role_resilience)",
      "effective_fixture_suppression": "fixture_suppression_raw * resilience_adjustment",
      "pre_suppression_role_quality": "sqrt(evidence_role_score_0_1 * role_resilience)",
      "final_tactical_role_score": "100 * pre_suppression_role_quality * (1 - fixture_suppression_effective)"
    },
    "missing_data": {
      "optional_context": "EXPLICIT_UNAVAILABLE_AND_OMITTED_FROM_AVAILABLE_MEAN",
      "missing_fixture_suppression": "CONTEXTUAL_SCORE_UNSCORABLE_FALLBACK_TO_EVIDENCE_ROLE_SCORE_WITH_DIAGNOSTIC",
      "missing_is_zero": false,
      "missing_is_neutral_fact": false
    },
    "double_count_guards": {
      "home_context": "VENUE_SPECIFIC_DELTAS_ONLY; GENERIC OPPONENT STRENGTH EXCLUDED",
      "attacking_involvement": "INTERACTION_RESILIENCE_ONLY; NOT RE-ADDED AS EVENT EXPECTATION",
      "role_security": "P1.1_CONSUMED_NOT_OWNED; INTERACTION_ONLY",
      "scoring_channels": "P1.3_EVENT_SURFACE_CONSUMED_READ_ONLY; NO POSTERIOR REWRITE",
      "fixture_suppression": "NEUTRAL_OPPONENT_STRENGTH_ONLY; VENUE DELTA EXCLUDED",
      "transfer_cost": "FORBIDDEN_FROM_INTRINSIC_TACTICAL_ROLE_SCORE"
    },
    "parameter_binding": {
      "parameter_set_id": "P1_6_CONTEXTUAL_BOUNDED_STRUCTURAL_V1",
      "parameter_version": "p1.6-contextual-role-v2",
      "calibration_authority": "P1.5_CALIBRATION_DECISION_LEDGER",
