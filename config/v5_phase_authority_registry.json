{
  "version": 4,
  "phases": {
    "PRE_DEADLINE": {
      "squad": ["user_lock", "official_public"],
      "lineup": ["user_lock", "official_public"],
      "captaincy": ["user_lock", "official_public"],
      "finance": ["public_reconstruction", "official_authenticated_enrichment"],
      "scoring": ["official_public"]
    },
    "POST_DEADLINE": {
      "squad": ["official_public"],
      "lineup": ["official_public"],
      "captaincy": ["official_public"],
      "finance": ["public_reconstruction", "official_authenticated_enrichment"],
      "scoring": ["official_public"]
    },
    "LIVE": {
      "squad": ["official_public"],
      "lineup": ["official_public"],
      "captaincy": ["official_public"],
      "finance": ["public_reconstruction", "official_authenticated_enrichment"],
      "scoring": ["official_public_event_live"]
    },
    "POST_GW": {
      "squad": ["official_public"],
      "lineup": ["official_public"],
      "captaincy": ["official_public"],
      "finance": ["public_reconstruction", "official_authenticated_enrichment"],
      "scoring": ["official_final_history"]
    }
  },
  "reconciliation": {
    "after_deadline": true,
    "compare": ["target_gw_user_capture_if_active", "submitted_picks"],
    "submitted_picks_become_baseline": true
  },
  "pre_deadline_governance": {
    "primary_authority_model": "PUBLIC_OFFICIAL_PLUS_USER_CAPTURE",
    "official_public_submitted_is_default_planning_baseline": true,
    "user_capture_may_override_only_for_explicit_target_gw": true,
    "user_capture_requires_active_wc_fh_or_planning_override": true,
    "stale_or_unscoped_user_capture_must_not_mask_official_submitted_team": true,
    "post_deadline_official_submission_reclaims_authority": true,
    "authenticated_official_is_optional_private_enrichment": true,
    "authenticated_official_must_not_be_squad_lineup_or_captaincy_authority": true,
    "authenticated_official_failure_must_not_block_public_production_path": true
  }
}
