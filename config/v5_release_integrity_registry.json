{
  "version": 8,
  "contract": "V5_RUNTIME_RELEASE_FINGERPRINT_V8",
  "algorithm": "sha256",
  "include_roots": ["src/v5", "config/intelligence", "config/rules", "config/venues"],
  "include_files": [
    "config/engine.json",
    "config/dss_core_registry.json",
    "config/dss_extension_registry.json",
    "config/enhancement_layers_registry.json",
    "config/gate0_registry.json",
    "config/sources/registry.json",
    "config/v5_acceptance_registry.json",
    "config/v5_architecture_principles.json",
    "config/v5_artifact_contract_registry.json",
    "config/v5_auth_policy_registry.json",
    "config/v5_cluster_health_registry.json",
    "config/v5_decision_registry.json",
    "config/v5_dss_policy_registry.json",
    "config/v5_execution_plane_registry.json",
    "config/v5_module_registry.json",
    "config/v5_orchestrator_registry.json",
    "config/v5_payload_contract_registry.json",
    "config/v5_performance_budgets.json",
    "config/v5_persistence_registry.json",
    "config/v5_registry_catalog.json",
    "config/v5_runner_registry.json",
    "config/v5_runtime_materialization_registry.json",
    "config/v5_service_registry.json",
    "config/v5_service_transport_registry.json",
    "config/v5_service_wire_registry.json",
    "config/v5_shadow_parity_registry.json",
    "config/v5_source_authority_registry.json",
    "config/v5_capability_parity_registry.json",
    "config/v5_release_attestation_registry.json",
    "config/v5_team_review_registry.json"
  ],
  "exclude_paths": [
    "config/v5_shadow_trigger.json",
    "config/v5_on_demand_trigger.json",
    "config/v5_convergence_manifest.json"
  ],
  "exact_execution": {
    "contract": "V5_EXACT_EXECUTION_FINGERPRINT_V1",
    "replay_contract": "V5_POINT_IN_TIME_REPLAY_V1",
    "code_revision_env": ["V5_CODE_REVISION", "GITHUB_SHA"],
    "require_code_revision_for_promotion": true,
    "runtime_release_fingerprint_is_always_required": true,
    "replay_fingerprint_excludes_execution_identity": true,
    "execution_fingerprint_binds_correlation_and_capture_time": true,
    "raw_authenticated_payload_forbidden": true,
    "replay_boundary": "POST_TRUTH_PRE_INTELLIGENCE",
    "required_replay_inputs": [
      "bootstrap",
      "fixtures",
      "truth",
      "event_live",
      "source_fusion",
      "state_hydration",
      "runner_policy"
    ],
    "replay_output_volatile_fields": [
      "generated_at",
      "evaluated_at",
      "created_at",
      "updated_at",
      "correlation_id",
      "elapsed_ms",
      "round_trip_ms",
      "transport_overhead_ms"
    ]
  },
  "governance": {
    "path_and_content_hashing": true,
    "sorted_deterministically": true,
    "trigger_and_status_metadata_do_not_reset_acceptance": true,
    "runtime_or_governance_code_change_resets_acceptance": true,
    "performance_budget_change_resets_acceptance": true,
    "wire_or_payload_or_materialization_policy_change_resets_acceptance": true,
    "execution_plane_policy_change_resets_acceptance": true,
    "venue_authority_change_resets_acceptance": true,
    "production_baseline_is_bound_separately": true,
    "same_replay_fingerprint_must_represent_same_canonical_inputs": true,
    "point_in_time_replay_must_not_refetch_current_sources": true,
    "replay_output_comparison_ignores_only_registry_declared_volatile_fields": true
  }
}
