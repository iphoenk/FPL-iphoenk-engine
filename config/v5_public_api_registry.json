{
  "version": 3,
  "transport": {
    "api_base_env": "FPL_API_BASE",
    "api_base_default": "https://fantasy.premierleague.com/api",
    "timeout_env": "FPL_TIMEOUT",
    "timeout_seconds_default": 20,
    "retries_config": "config/engine.json",
    "retries_key": "api_retries",
    "backoff_key": "api_backoff_seconds",
    "parallel_max_workers": 6,
    "allow_redirects": true
  },
  "cache": {
    "enabled": true,
    "directory_env": "V5_PUBLIC_API_CACHE_DIR",
    "directory_default": "data/cache/v5_public_api",
    "default_ttl_seconds": 120,
    "route_ttl_seconds": {
      "bootstrap": 180,
      "fixtures": 120,
      "event_status": 60,
      "entry": 60,
      "entry_history": 120,
      "entry_transfers": 60,
      "entry_picks": 15,
      "event_live": 15,
      "element_summary": 120,
      "set_piece_notes": 300,
      "classic_league_standings": 60,
      "h2h_league_standings": 60
    },
    "singleflight": {
      "enabled": true,
      "wait_seconds": 5.0,
      "poll_ms": 50,
      "stale_lock_seconds": 30.0
    }
  },
  "endpoints": {
    "bootstrap": "bootstrap-static/",
    "fixtures": "fixtures/",
    "event_status": "event-status/",
    "entry": "entry/{team_id}/",
    "entry_history": "entry/{team_id}/history/",
    "entry_transfers": "entry/{team_id}/transfers/",
    "entry_picks": "entry/{team_id}/event/{event}/picks/",
    "event_live": "event/{event}/live/",
    "element_summary": "element-summary/{element}/",
    "set_piece_notes": "team/set-piece-notes/",
    "classic_league_standings": "leagues-classic/{league_id}/standings/",
    "h2h_league_standings": "leagues-h2h/{league_id}/standings/"
  },
  "collection_groups": {
    "base": ["bootstrap", "fixtures", "event_status", "entry", "entry_history", "entry_transfers"],
    "live": ["event_live"],
    "submitted": ["entry_picks"]
  }
}
