    "post_match_attribution_label": "POSSIBLE_CONTRIBUTING_FACTOR",
    "causal_claim_requires_calibrated_evidence": true,
    "alternative_explanations_required": ["opponent_strength", "tactical_change", "game_state", "red_cards", "injury", "rotation", "role_change", "venue", "sample_noise"]
  }
