    {
      "id": "wikidata",
      "name": "Wikidata Query Service",
      "category": "identity_bridge_reference",
      "adapter": "http",
      "critical": false,
      "check_freshness_minutes": 720,
      "independence_group": "wikidata",
      "entity_scopes": [
        "TEAM",
        "COMPETITION"
      ],
      "requests": [
        {
          "id": "premier_league_clubs",
          "url": "https://query.wikidata.org/sparql",
          "params": {
            "format": "json",
            "query": "SELECT ?club ?clubLabel ?website WHERE { ?club wdt:P118 wd:Q9448 . OPTIONAL { ?club wdt:P856 ?website . } SERVICE wikibase:label { bd:serviceParam wikibase:language \"en\". } } ORDER BY ?clubLabel"
          },
          "expect": "json",
          "validation": {
            "min_body_bytes": 100
          }
        }
      ],
      "access": {
        "cost": "ZERO",
        "account_required": false,
        "login_required": false,
        "private_api_key_required": false,
        "private_token_required": false,
        "shared_public_key": false
      },
      "notes": "Public no-auth SPARQL corroboration only. Results never supersede Official FPL identity and never authorize fuzzy runtime joins."
    },
    {
      "id": "open_meteo",
      "name": "Open-Meteo Forecast API",
      "category": "fixture_weather_context",
      "adapter": "http",
      "critical": false,
      "check_freshness_minutes": 180,
      "independence_group": "open_meteo",
      "entity_scopes": [
        "TEAM",
        "FIXTURE"
      ],
      "requests": [
        {
          "id": "premier_league_venues",
          "url": "https://api.open-meteo.com/v1/forecast",
          "params": {
            "hourly": "temperature_2m,precipitation_probability,precipitation,wind_speed_10m,wind_gusts_10m,weather_code",
            "forecast_days": "16",
            "timezone": "GMT"
          },
          "params_from_records": {
            "path": "config/v6/venue_geography.json",
            "records_key": "venues",
            "format": "csv",
            "fields": {
              "latitude": "latitude",
              "longitude": "longitude"
            }
          },
          "expect": "json",
          "validation": {
            "min_body_bytes": 1000
          }
        }
      ],
      "access": {
        "cost": "ZERO",
        "account_required": false,
        "login_required": false,
        "private_api_key_required": false,
        "private_token_required": false,
        "shared_public_key": false
      },
      "notes": "No-auth raw venue forecast acquisition. Venue coordinates and ordering are owned only by config/v6/venue_geography.json. V6 stores provider weather fields only and computes no FPL impact, xPts multiplier or transfer decision."
    },
