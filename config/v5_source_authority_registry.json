{
  "version": 4,
  "policy": "Official FPL remains the only native external authority. PRE_DEADLINE planning follows PUBLIC_OFFICIAL_PLUS_USER_CAPTURE: the Official public submitted team is the default baseline and user capture may override only when exactly scoped to the target GW with an active WC/FH/planning override. Authenticated Official is optional private enrichment only. Challenger and enrichment sources may add evidence or fill explicitly missing non-native fields, but never silently override Official FPL native fields, never fabricate missing data, and never confuse source reachability with capability health.",
  "source_registry": "config/sources/registry.json",
  "governance": {
    "official_fpl_only_native_external_authority": true,
    "challenger_never_overrides_official_native": true,
    "missing_enrichment_never_fabricated": true,
    "source_failure_isolated_by_default": true,
    "source_reachability_is_separate_from_capability_health": true,
    "stale_observations_are_never_silently_current": true,
    "challenger_observation_contract": "challenger_observation_v2",
    "predeadline_primary_authority_model": "PUBLIC_OFFICIAL_PLUS_USER_CAPTURE",
    "official_public_submitted_is_default_planning_baseline": true,
    "user_capture_requires_exact_target_gw_and_active_planning_override": true,
    "stale_or_unscoped_user_capture_must_not_mask_official_submitted_team": true,
    "authenticated_official_is_optional_private_enrichment": true,
    "authenticated_official_must_not_be_squad_lineup_or_captaincy_authority": true
  },
  "sources": {
    "user_capture": {"tier": 0, "kind": "user_authority", "enabled": true},
    "official_authenticated": {"tier": 1, "kind": "official_private_read_only", "enabled": true},
    "official_public": {"tier": 1, "kind": "official_public", "enabled": true},
    "core_insights": {"tier": 2, "kind": "enrichment", "enabled": true},
    "livefpl": {"tier": 2, "kind": "challenger", "enabled": true},
    "onefpl": {"tier": 2, "kind": "challenger", "enabled": true},
    "fffix": {"tier": 2, "kind": "challenger", "enabled": true},
    "ffhub": {"tier": 2, "kind": "challenger", "enabled": true},
    "api_football": {"tier": 2, "kind": "optional_enrichment", "enabled": true},
    "ffscout": {"tier": 3, "kind": "enrichment", "enabled": true},
    "vaastav": {"tier": 3, "kind": "historical_backbone", "enabled": true},
    "understat": {"tier": 4, "kind": "optional_enrichment", "enabled": true}
  },
  "domains": {
    "player_identity": ["official_public"],
    "fixtures": ["official_public"],
    "submitted_squad": ["official_public"],
    "live_scoring": ["official_public"],
    "authenticated_draft": ["official_authenticated"],
    "exact_owned_finance": ["official_authenticated"],
    "pre_deadline_locked_squad": ["official_public", "user_capture"],
    "advanced_player_stats": ["core_insights", "ffscout", "vaastav", "understat"],
    "historical_priors": ["vaastav", "core_insights"],
    "price_prediction_challengers": ["livefpl", "onefpl", "fffix"],
    "predicted_points_challengers": ["fffix", "ffhub"],
    "role_and_team_news_enrichment": ["ffscout"],
    "effective_ownership_challenger": ["livefpl", "ffhub"],
    "cross_competition_schedule_context": ["api_football"]
  }
}
