{
  "schema_version": 3,
  "registry": "V3_INTERACTIVE_SERVICES_V1",
  "architecture": "UNIFIED_INTERACTIVE_FASTPATH",
  "policy": {
    "background_refresh_and_interactive_decision_are_separate_lanes": true,
    "interactive_services_consume_canonical_artifacts": true,
    "interactive_services_do_not_fetch_network": true,
    "interactive_services_do_not_reimplement_prediction_formulas": true,
    "decision_regeneration_must_recompute_governed_decision_from_fresh_projections": true,
    "gateway_serves_only_validated_materialized_or_regenerated_decisions": true,
    "single_pass_artifact_load_and_validation": true,
    "performance_slo_registry": "config/runtime/performance_slo.json",
    "performance_slo_profile": "instant_serving"
  },
  "services": {
    "unified_fastpath": {
      "bounded_context": "validated interactive decision regeneration and serving",
      "module": "src.runtime_v3.unified_fastpath",
      "owns": ["interactive_lineup_package_regeneration", "interactive_validated_response"],
      "consumes": ["projections.json","package_optimizer.json","team.json","chips.json","latest.json","framework_health.json","dss_watchlist_summary.json","decision_brief.json","user_report.json","config/locked_squad.json"],
      "network": false,
      "writes_canonical_artifacts": false
    }
  },
  "compatibility_entrypoints": {
    "decision_hotpath": "src.engines.decision_hotpath_service",
    "instant_gateway": "src.runtime_v3.instant_serving"
  }
}
