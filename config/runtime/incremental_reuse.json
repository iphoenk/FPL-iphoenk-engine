{
  "schema_version": 1,
  "registry": "V3_INCREMENTAL_REUSE_V1",
  "policy": {
    "enabled_profiles": ["fast_decision", "live"],
    "disable_when_current_scoring_fixture_live": true,
    "live_reuse_requires_explicit_service_opt_in": true,
    "reuse_requires_matching_input_fingerprint": true,
    "reuse_requires_all_declared_artifacts": true,
    "reuse_never_bypasses_artifact_validation": true,
    "reuse_is_disabled_for_network_owners": true,
    "reuse_is_invalidated_by_source_tree_change": true,
    "full_refresh_and_deep_stats_never_use_fingerprint_reuse": true,
    "missing_or_invalid_fingerprint_falls_back_to_execution": true,
    "reuse_only_when_avoided_compute_exceeds_fingerprint_cost": true,
    "cheap_decision_consumers_execute_and_validate_directly": true,
    "expensive_deterministic_enrichment_may_use_exact_fingerprint_reuse": true,
    "self_owned_rolling_state_may_record_post_execution_fingerprint_only_when_idempotent": true,
    "full_optimizer_reuse_requires_optimizer_config_in_prediction_fingerprint": true,
    "football_formulas_unchanged": true
  },
  "services": {
    "prediction": {
      "allow_during_live": true,
      "inputs": [
        "src/",
        "official_snapshot.json",
        "team.json",
        "prior_season.json",
        "player_features.json",
        "tactical_team_profiles.json",
        "player_role_profiles.json",
        "recent_tactical_form.json",
        "config/locked_squad.json",
        "config/intelligence/projection.json",
        "config/intelligence/team_strength.json",
        "config/intelligence/xmins_v2.json",
        "config/intelligence/package_optimizer.json"
      ]
    },
    "tactical_context": {
      "record_post_execution_fingerprint": true,
      "self_owned_rolling_state": "recent_tactical_form.json",
      "inputs": [
        "src/",
        "official_snapshot.json",
        "player_features.json",
        "stats/shots_current.json",
        "stats/playermatchstats_current.json",
        "recent_tactical_form.json",
        "stats/understat_epl_2026.json",
        "config/intelligence/tactical_observed_context.json",
        "config/intelligence/understat_tactical.json"
      ]
    }
  }
}
