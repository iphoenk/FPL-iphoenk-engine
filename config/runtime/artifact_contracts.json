{
  "schema_version": 2,
  "registry": "RUNTIME_ARTIFACT_CONTRACTS_V2",
  "policy": {
    "validate_declared_json_before_acceptance": true,
    "validate_latest_sidecar_when_present": true,
    "unknown_json_contract": "PARSE_ONLY",
    "malformed_json_is_integrity_failure": true,
    "valid_empty_external_observations_are_allowed": true,
    "valid_empty_weather_window_is_allowed": true
  },
  "contracts": {
    "challenger_observations.json": {
      "root_type": "object",
      "required_fields": ["schema_version", "contract", "observations"],
      "equals": {"schema_version": 2, "contract": "challenger_observation_v2"},
      "types": {"observations": "list", "counts": "object", "cross_source": "list", "policy": "object"}
    },
    "external_benchmark_observations.json": {
      "root_type": "object",
      "required_fields": ["schema_version", "contract", "observations"],
      "equals": {"schema_version": 1, "contract": "EXTERNAL_BENCHMARK_OBSERVATIONS_V1"},
      "types": {"observations": "list"}
    },
    "external_consensus.json": {
      "root_type": "object",
      "required_fields": ["schema_version", "contract", "generated_at", "owner", "native_conclusion_frozen_before_overlay", "overall", "observations", "subjects", "source_status", "governance"],
      "equals": {"schema_version": 1, "contract": "EXTERNAL_CONSENSUS_V1", "owner": "governance.external_consensus", "native_conclusion_frozen_before_overlay": true},
      "types": {"observations": "list", "subjects": "list", "source_status": "object", "governance": "object", "authority": "object", "native_snapshot": "object"}
    },
    "recent_competitive_load.json": {
      "root_type": "object",
      "required_fields": ["schema_version", "contract", "generated_at", "owner", "status", "players", "player_count", "state_counts", "governance"],
      "equals": {"schema_version": 1, "contract": "COMPETITIVE_LOAD_PRIMITIVE_V1", "owner": "governance.competitive_load"},
      "types": {"players": "object", "player_count": "integer", "state_counts": "object", "governance": "object"}
    },
    "fixture_weather.json": {
      "root_type": "object",
      "required_fields": ["schema_version", "model", "provider", "fixtures", "material_fixtures", "governance"],
      "equals": {"schema_version": 1, "model": "weather_context_observational_v1", "provider": "open_meteo"},
      "types": {"fixtures": "list", "material_fixtures": "list", "governance": "object", "fixture_count": "integer", "available_count": "integer", "material_count": "integer"}
    },
    "player_features.json": {
      "root_type": "object",
      "required_fields": ["schema_version", "contract", "generated_at", "decision_neutral", "model_opt_in", "players", "policy"],
      "equals": {"schema_version": 1, "contract": "PLAYER_FEATURE_CONTRACT_V1", "decision_neutral": false, "model_opt_in": "REC-01"},
      "types": {"players": "object", "policy": "object", "official_player_count": "integer", "advanced_row_count": "integer", "advanced_player_coverage": "integer"}
    },
    "tactical_team_profiles.json": {
      "root_type": "object",
      "required_fields": ["schema_version", "contract", "generated_at", "status", "teams", "governance"],
      "equals": {"schema_version": 2, "contract": "TACTICAL_TEAM_PROFILES_V1"},
      "types": {"teams": "object", "governance": "object"}
    },
    "player_role_profiles.json": {
      "root_type": "object",
      "required_fields": ["schema_version", "contract", "generated_at", "status", "players", "governance"],
      "equals": {"schema_version": 2, "contract": "TACTICAL_PLAYER_ROLE_PROFILES_V1"},
      "types": {"players": "object", "governance": "object", "assessed_players": "integer", "return_route_players": "integer", "total_players": "integer"}
    },
    "recent_tactical_form.json": {
      "root_type": "object",
      "required_fields": ["schema_version", "contract", "generated_at", "status", "source_contract", "teams", "governance"],
      "equals": {"schema_version": 2, "contract": "RECENT_TACTICAL_FORM_V1", "source_contract": "TACTICAL_OBSERVED_CONTEXT_V1"},
      "types": {"teams": "object", "governance": "object"}
    }
  }
}
