{
  "schema_version": 1,
  "contract": "report_time_evidence_v1",
  "required_signal_fields": [
    "source_id",
    "source_class",
    "topic",
    "subject",
    "stance",
    "observed_at",
    "source_url",
    "summary"
  ],
  "lineage_required_for_sources": [
    "fpl_analytics_dashboard",
    "allaboutfpl"
  ],
  "required_lineage_fields": [
    "fetched_at",
    "freshness_state",
    "root_family",
    "independence_state",
    "identity_state",
    "parser_version"
  ],
  "allowed_source_classes": [
    "MODEL_CHALLENGER",
    "DIAGNOSTIC_CHALLENGER",
    "ANALYTICAL_CHALLENGER",
    "FIXTURE_STRATEGY_EXPERT",
    "PUNDIT_CONSENSUS",
    "COMMUNITY_SIGNAL",
    "SECONDARY_AVAILABILITY",
    "VERIFIED_NEWS"
  ],
  "allowed_stances": [
    "BUY",
    "SELL",
    "HOLD",
    "WATCH",
    "CAPTAIN",
    "AVOID_CAPTAIN",
    "START",
    "BENCH",
    "CHIP_NOW",
    "CHIP_WAIT",
    "FIXTURE_ALERT",
    "ROLE_POSITIVE",
    "ROLE_NEGATIVE",
    "INJURY_RISK",
    "NEUTRAL"
  ],
  "policy": {
    "facts_require_verified_source_or_independent_crosscheck": true,
    "pundit_votes_are_advisory": true,
    "community_signal_does_not_become_fact_by_vote_count": true,
    "secondary_availability_is_advisory_and_requires_crosscheck": true,
    "fixture_expert_signals_do_not_vote_in_player_consensus": true,
    "onefpl_signals_are_model_challenger_context": true,
    "signals_without_source_url_are_rejected": true,
    "stale_or_unavailable_evidence_is_not_current": true,
    "root_family_is_required_for_external_lineage": true,
    "external_evidence_is_categorical_not_a_score": true
  },
  "optional_availability_fields": [
    "availability_evidence",
    "evidence_type",
    "claim_domain",
    "evidence_polarity",
    "raw_claim",
    "normalized_claim",
    "injury_confirmed",
    "injury_mechanism",
    "body_part",
    "withdrawn_from_squad",
    "returned_to_club",
    "training_status",
    "match_status",
    "manager_severity",
    "manager_availability_language",
    "club_assessment",
    "expected_return",
    "expected_return_source",
    "expected_return_authority",
    "target_gw",
    "target_fixture_id",
    "root_source_id",
    "root_source_type",
    "is_republication",
    "no_injury_explicit",
    "availability",
    "explicit_target_unavailable"
  ],
  "availability_semantics": {
    "evidence_layer_contract": "V12_TARGET_AWARE_AVAILABILITY_EVIDENCE_V1",
    "raw_claim_preserved": true,
    "free_text_medical_inference_forbidden": true,
    "fpl_flag_is_probability": false,
    "gw_availability_is_categorical": true,
    "pstart_owner": "V12_PLAYER_MINUTES"
  }
}
