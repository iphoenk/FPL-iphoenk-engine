{
  "version": 2,
  "contract": "V5_RUNTIME_RELEASE_FINGERPRINT_V2",
  "algorithm": "sha256",
  "include_roots": ["src/v5", "config/intelligence", "config/rules"],
  "include_files": [
    "config/engine.json",
    "config/dss_core_registry.json",
    "config/dss_extension_registry.json",
    "config/enhancement_layers_registry.json",
    "config/gate0_registry.json",
    "config/sources/registry.json",
    "config/v5_acceptance_registry.json",
    "config/v5_architecture_principles.json",
    "config/v5_auth_policy_registry.json",
    "config/v5_cluster_health_registry.json",
    "config/v5_decision_registry.json",
    "config/v5_dss_policy_registry.json",
    "config/v5_orchestrator_registry.json",
    "config/v5_persistence_registry.json",
    "config/v5_runner_registry.json",
    "config/v5_service_registry.json",
    "config/v5_shadow_parity_registry.json",
    "config/v5_source_authority_registry.json",
    "config/v5_capability_parity_registry.json",
    "config/v5_release_attestation_registry.json",
    "config/v5_team_review_registry.json"
  ],
  "exclude_paths": [
    "config/v5_shadow_trigger.json",
    "config/v5_on_demand_trigger.json",
    "config/v5_convergence_manifest.json"
  ],
  "governance": {
    "path_and_content_hashing": true,
    "sorted_deterministically": true,
    "trigger_and_status_metadata_do_not_reset_acceptance": true,
    "runtime_or_governance_code_change_resets_acceptance": true,
    "production_baseline_is_bound_separately": true
  }
}
