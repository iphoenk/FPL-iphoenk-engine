{
  "version": 4,
  "authority_model": "PUBLIC_OFFICIAL_PLUS_USER_CAPTURE",
  "phases": {
    "PRE_DEADLINE": {
      "squad": ["user_capture", "official_public"],
      "lineup": ["user_capture", "official_public"],
      "captaincy": ["user_capture", "official_public"],
      "finance": ["official_authenticated", "public_reconstruction"],
      "scoring": ["official_public"]
    },
    "POST_DEADLINE": {
      "squad": ["official_public"],
      "lineup": ["official_public"],
      "captaincy": ["official_public"],
      "finance": ["official_authenticated", "public_reconstruction"],
      "scoring": ["official_public"]
    },
    "LIVE": {
      "squad": ["official_public"],
      "lineup": ["official_public"],
      "captaincy": ["official_public"],
      "finance": ["official_authenticated", "public_reconstruction"],
      "scoring": ["official_public_event_live"]
    },
    "POST_GW": {
      "squad": ["official_public"],
      "lineup": ["official_public"],
      "captaincy": ["official_public"],
      "finance": ["official_authenticated", "public_reconstruction"],
      "scoring": ["official_final_history"]
    }
  },
  "reconciliation": {
    "after_deadline": true,
    "compare": ["latest_pre_deadline_authority", "submitted_picks"],
    "submitted_picks_become_baseline": true
  },
  "pre_deadline_governance": {
    "public_official_is_universal_factual_backbone": true,
    "user_capture_is_current_private_draft_authority_when_target_gw_matches": true,
    "user_capture_must_be_target_gw_scoped": true,
    "official_public_submitted_is_fallback_when_no_current_capture": true,
    "official_public_submitted_represents_last_confirmed_team_not_unsubmitted_draft": true,
    "authenticated_official_is_optional_private_enrichment": true,
    "authenticated_official_is_production_blocking": false,
    "authenticated_official_must_not_override_user_capture": true,
    "stale_persistent_capture_must_not_mask_last_confirmed_official_submitted_team": true
  }
}
