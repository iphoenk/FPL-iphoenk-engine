  "governance": {
    "path_and_content_hashing": true,
    "sorted_deterministically": true,
    "trigger_and_status_metadata_do_not_reset_acceptance": true,
    "runtime_or_governance_code_change_resets_acceptance": true,
    "performance_budget_change_resets_acceptance": true,
