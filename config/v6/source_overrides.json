{
  "schema_version": 3,
  "policy": {
    "role": "TEMPORARY_REPAIR_ONLY",
    "max_active_overrides": 15,
    "stable_repairs_should_be_promoted_to_canonical_registry": true,
    "inactive_sources_must_not_have_overrides": true,
    "effective_registry_is_published_for_drift_review": true
  },
  "lifecycle": {
    "official_fpl": {"temporary": true, "reason": "Runtime request and body-size hardening pending canonical promotion", "review_by": "2026-10-01"},
    "official_price_predictor": {"temporary": true, "reason": "Required dependency contract pending canonical promotion", "review_by": "2026-10-01"},
    "opta_the_analyst": {"temporary": true, "reason": "Current public stats endpoint validation repair", "review_by": "2026-10-01"},
    "statmuse": {"temporary": true, "reason": "Current public query validation repair", "review_by": "2026-10-01"},
    "onefpl": {"temporary": true, "reason": "Current-season price page validation repair", "review_by": "2026-10-01"},
    "livefpl": {"temporary": true, "reason": "Current public price endpoints repair", "review_by": "2026-10-01"},
    "fotmob": {"temporary": true, "reason": "Current league API shape repair", "review_by": "2026-10-01"},
    "espn": {"temporary": true, "reason": "Current public scoreboard API shape repair", "review_by": "2026-10-01"},
    "understat": {"temporary": true, "reason": "Current EPL page and POST players endpoint repair", "review_by": "2026-10-01"},
    "onside": {"temporary": true, "reason": "Current predicted-points public page validation repair", "review_by": "2026-10-01"},
    "statsbomb": {"temporary": true, "reason": "Open-data cadence and dedup runtime hardening", "review_by": "2026-10-01"},
    "vaastav_fpl": {"temporary": true, "reason": "2026-27 current-season file surface repair", "review_by": "2026-10-01"},
    "solio_analytics": {"temporary": true, "reason": "Public no-auth source cadence hardening", "review_by": "2026-10-01"},
    "check_the_chance": {"temporary": true, "reason": "Public source cadence and dedup hardening", "review_by": "2026-10-01"},
    "fantasy_football_pundit": {"temporary": true, "reason": "Public source cadence and body-size hardening", "review_by": "2026-10-01"}
  },
  "sources": {
    "official_fpl": {
      "acquisition_kind": "rest_json",
      "poll_interval_minutes": 60,
      "required_for_platform": true,
      "max_body_bytes": 4000000
    },
    "official_price_predictor": {
      "required_for_platform": true,
      "depends_on": ["official_fpl"]
    },
    "opta_the_analyst": {
      "requests": [
        {
          "id": "premier_league_stats",
          "url": "https://theanalyst.com/competition/premier-league/stats",
          "expect": "text",
          "validation": {"required_text_any": ["Premier League Stats"]}
        }
      ]
    },
    "statmuse": {
      "requests": [
        {
          "id": "team_xg",
          "url": "https://www.statmuse.com/fc/ask/premier-league-xg-by-team",
          "expect": "text",
          "validation": {"required_text_all": ["Premier League", "xG"]}
        }
      ]
    },
    "onefpl": {
      "requests": [
        {
          "id": "prices",
          "url": "https://onefpl.com/prices",
          "expect": "text",
          "validation": {"required_text_all": ["Price Changes", "2026/27"]}
        }
      ]
    },
    "livefpl": {
      "requests": [
        {
          "id": "prices",
          "url": "https://www.livefpl.net/prices",
          "expect": "text",
          "validation": {"required_text_any": ["LiveFPL Price Changes"]}
        },
        {
          "id": "price_changes",
          "url": "https://plan.livefpl.net/price_changes",
          "expect": "text",
          "validation": {"required_text_any": ["price changes", "Price Changes"]}
        }
      ]
    },
    "fotmob": {
      "requests": [
        {
          "id": "league",
          "url": "https://www.fotmob.com/api/data/leagues",
          "params": {"id": "47", "ccode3": "ENG", "season": "2026/2027"},
          "expect": "json",
          "validation": {"required_json_paths": ["details.id", "details.selectedSeason"]}
        }
      ]
    },
    "espn": {
      "requests": [
        {
          "id": "scoreboard",
          "url": "https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard",
          "expect": "json",
          "use_default_user_agent": true,
          "validation": {"required_json_paths": ["leagues", "events"]}
        }
      ]
    },
    "understat": {
      "acquisition_kind": "generic_http",
      "poll_interval_minutes": 60,
      "content_hash_dedup": true,
      "requests": [
        {
          "id": "epl_2026",
          "url": "https://understat.com/league/EPL/2026",
          "expect": "text",
          "validation": {"required_text_all": ["2026/2027", "xG"]}
        },
        {
          "id": "players_api",
          "url": "https://understat.com/main/getPlayersStats/",
          "method": "POST",
          "form": {"league": "EPL", "season": "2026"},
          "headers": {"Referer": "https://understat.com/league/EPL/2026", "X-Requested-With": "XMLHttpRequest"},
          "expect": "json",
          "validation": {"required_json_paths": ["players"]}
        }
      ]
    },
    "onside": {
      "requests": [
        {
          "id": "predicted_points",
          "url": "https://onsidearena.com/fpl/predicted-points",
          "expect": "text",
          "validation": {"required_text_all": ["Predicted Points", "2026/27"]}
        }
      ]
    },
    "statsbomb": {
      "acquisition_kind": "rest_json",
      "poll_interval_minutes": 1440,
      "check_freshness_minutes": 1500,
      "content_hash_dedup": true
    },
    "vaastav_fpl": {
      "requests": [
        {
          "id": "players_raw",
          "url": "https://raw.githubusercontent.com/vaastav/Fantasy-Premier-League/master/data/2026-27/players_raw.csv",
          "expect": "csv",
          "validation": {"min_body_bytes": 1000, "required_text_any": ["first_name", "second_name"]}
        },
        {
          "id": "fixtures",
          "url": "https://raw.githubusercontent.com/vaastav/Fantasy-Premier-League/master/data/2026-27/fixtures.csv",
          "expect": "csv",
          "validation": {"min_body_bytes": 1000, "required_text_any": ["kickoff_time", "team_h", "team_a"]}
        },
        {
          "id": "player_idlist",
          "url": "https://raw.githubusercontent.com/vaastav/Fantasy-Premier-League/master/data/2026-27/player_idlist.csv",
          "expect": "csv",
          "validation": {"min_body_bytes": 1000, "required_text_any": ["first_name,second_name,id"]}
        }
      ]
    },
    "solio_analytics": {
      "acquisition_kind": "rest_json",
      "poll_interval_minutes": 240,
      "poll_interval_minutes_deadline_window": 60,
      "check_freshness_minutes": 300,
      "content_hash_dedup": true
    },
    "check_the_chance": {
      "acquisition_kind": "html_scrape",
      "poll_interval_minutes": 360,
      "poll_interval_minutes_deadline_window": 60,
      "check_freshness_minutes": 420,
      "content_hash_dedup": true
    },
    "fantasy_football_pundit": {
      "acquisition_kind": "html_scrape",
      "poll_interval_minutes": 360,
      "poll_interval_minutes_deadline_window": 60,
      "check_freshness_minutes": 420,
      "content_hash_dedup": true,
      "max_body_bytes": 4000000
    }
  }
}
