{
  "schema_version": 1,
  "engine": "V6_FRESH_DATA_PLATFORM",
  "primary_cron_utc": "23 * * * *",
  "recovery_cron_utc": "53 * * * *",
  "schedule_authority": true,
  "source_registry_schedule_metadata_authoritative": false,
  "manual_recovery": {
    "enabled": true,
    "schedule_kind": "manual_recovery",
    "authoritative_runtime_snapshot": false,
    "counts_as_completed_scheduled_slot": false,
    "allowed_actor": "repository_owner",
    "confirmation_phrase": "RECOVER_V6"
  },
  "governance": {
    "scheduled_runtime_is_primary_authority": false,
    "single_schedule_owner": "config/v6/schedule_policy.json",
    "manual_recovery_never_masks_missed_schedule": true,
    "manual_recovery_must_use_dedicated_v6_publisher": true,
    "push_triggered_production_acquisition_allowed": false,
    "pull_request_triggered_production_acquisition_allowed": false,
    "avoid_top_of_hour_scheduler_load": true,
    "authoritative_operational_triggers": [
      "schedule:primary",
      "schedule:recovery",
      "workflow_dispatch:master_orchestrated",
      "issue_comment:master_orchestrated",
      "workflow_dispatch:report_prefetch",
      "issue_comment:report_prefetch"
    ],
    "master_orchestrated_is_authoritative": true,
    "master_orchestrated_never_masks_natural_scheduler_evidence": true,
    "report_prefetch_is_report_driven_only": true,
    "report_prefetch_has_no_independent_cron": true,
    "report_prefetch_reuses_runtime_data_v6_publisher": true,
    "report_prefetch_does_not_count_as_scheduled_core_cycle": true,
    "historical_backfill_is_ad_hoc_only": true,
    "historical_backfill_reuses_report_prefetch_control_plane": true
  },
  "master_orchestrated": {
    "enabled": true,
    "schedule_kind": "master_orchestrated",
    "authoritative_runtime_snapshot": true,
    "counts_as_completed_operational_slot": true,
    "counts_as_completed_scheduled_slot": false,
    "allowed_actor": "repository_owner",
    "reason_required": true,
    "control_issue_number": 431,
    "issue_comment_command": "/v6-master-acquire"
  },
  "report_prefetch": {
    "enabled": true,
    "schedule_kind": "report_prefetch",
    "report_driven": true,
    "independent_cron": false,
    "authoritative_runtime_snapshot": true,
    "counts_as_completed_operational_slot": true,
    "counts_as_completed_scheduled_slot": false,
    "allowed_actor": "repository_owner",
    "reason_required": true,
    "control_issue_number": 431,
    "issue_comment_command": "/v6-report-prefetch",
    "supported_report_kinds": [
      "full_master",
      "match_mode",
      "deadline_review",
      "ad_hoc",
      "historical_backfill",
      "05:30_price"
    ],
    "historical_backfill": {
      "scope": "mini_league",
      "completed_gws_allowed": true,
      "current_post_deadline_gw_allowed": true,
      "future_gws_allowed": false,
      "requires_gw_range": true,
      "cohort_semantics": "CURRENT_COHORT_HISTORY"
    }
  }
}
