{
  "schema": "fpl_master_v12_price_presentation_lock.v1",
  "purpose": "Lock PRICE visible presentation to the canonical 12-section human analyst surface without changing factual, model, optimizer, scheduler, or decision authority.",
  "section_order": [
    "PRICE1",
    "PRICE2",
    "PRICE3",
    "PRICE4",
    "PRICE5",
    "PRICE6",
    "PRICE7",
    "PRICE8",
    "PRICE9",
    "PRICE10",
    "PRICE11",
    "PRICE12"
  ],
  "rules": {
    "canonical_truth_only": true,
    "no_recalculation_in_presentation": true,
    "generic_recursive_key_value_dump_forbidden": true,
    "raw_python_or_json_repr_forbidden": true,
    "element_id_forbidden_in_visible_tables": true,
    "raw_internal_field_names_forbidden": true,
    "machine_enum_as_primary_wording_forbidden": true,
    "raw_run_workflow_sha_fingerprint_forbidden_in_main_body": true,
    "fact_model_inference_must_remain_distinct": true,
    "price_alone_cannot_force_act": true,
    "tables_must_use_exact_columns_and_order": true
  },
  "sections": {
