    "config/v5_decision_registry.json",
    "config/v5_dss_policy_registry.json",
    "config/v5_execution_plane_registry.json",
    "config/v5_module_registry.json",
    "config/v5_orchestrator_registry.json",
    "config/v5_payload_contract_registry.json",
    "config/v5_performance_budgets.json",
