    "no_blanket_fatigue_penalty": true,
    "direct_xpts_mutation_forbidden": true,
    "direct_xmins_mutation_forbidden_until_calibrated": true,
    "allowed_use": ["evidence", "confidence", "tie_breaker", "rotation_review"],
    "coach_rotation_tendency_must_not_be_inferred_without_evidence": true,
    "travel_distance_must_not_be_invented": true,
    "one_match_does_not_create_buy_or_sell": true
  }
}
