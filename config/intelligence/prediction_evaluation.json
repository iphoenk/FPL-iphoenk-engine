{
  "schema_version": 5,
  "model_id": "prediction_evaluation_v1",
  "freeze_policy": "last_pre_deadline_snapshot",
  "settle_only_finished_events": true,
  "metrics": [
    "points_mae",
    "points_rmse",
    "xmins_mae",
    "starter_brier",
    "dnp_brier",
    "clean_sheet_brier",
    "spearman",
    "captain_regret",
    "vice_regret",
    "xi_regret",
    "bench_first_regret",
    "transfer_comparator_realized_net_gain"
  ],
  "decision_snapshot_contract": "DECISION_VALIDATION_SNAPSHOTS_V1",
  "decision_metric_policy": {
    "genuine_predeadline_snapshot_required": true,
    "retroactive_reconstruction_forbidden": true,
    "settlement_requires_finished_event": true,
    "exact_hit_cost_required_for_transfer_net_gain": true,
    "optimizer_change_penalty_is_not_hit_cost": true,
    "gross_points_delta_may_be_reported_when_net_gain_is_unavailable": true,
    "vice_and_bench_metrics_begin_only_after_genuine_capture": true
  },
  "confidence_sample_thresholds": {"low_max": 49, "medium_max": 149},
  "minimum_sample_for_dynamic_weight": 50,
  "calibration_bins": 5,
  "position_drift_alert": {
    "minimum_samples_per_position": 8,
    "mae_excess_threshold": 0.75,
    "diagnostic_only": true,
    "may_not_change_weights_automatically": true
  },
  "retrospective_proxy_baseline": {
    "enabled": true,
    "label": "RETROSPECTIVE_PROXY_BASELINE",
    "gameweeks": [1],
    "max_historical_gameweeks": 5,
    "count_toward_predictive_accuracy": false,
    "count_toward_dynamic_weight": false
  },
  "projection_confidence_audit": {
    "review_from_gw": 5,
    "minimum_high_count_after_review_gw": 1,
    "zero_high_before_review_is_not_failure": true,
    "zero_high_at_or_after_review_requires_calibration_review": true
  }
}
