{
  "schema_version": 2,
  "registry": "REPORT_TIME_SOURCE_REGISTRY_V1",
  "policy": {
    "official_fpl_remains_native_authority": true,
    "report_time_sources_never_mutate_dss": true,
    "report_time_sources_never_override_verified_facts": true,
    "missing_evidence_is_not_fabricated": true,
    "web_search_refresh_required_for_each_report": true,
    "stale_evidence_may_be_shown_but_not_counted_as_current_consensus": true,
    "community_signal_requires_crosscheck_before_fact_promotion": true,
    "pundit_consensus_is_advisory_only": true,
    "fixture_strategy_experts_do_not_vote_on_player_projection": true,
    "onefpl_is_report_time_only": true,
    "press_conference_sweep_required": true,
    "last_competitive_match_sweep_required": true,
    "tactical_external_sweep_required": true,
    "tactical_external_sweep_may_enrich_but_never_overwrite_observed_machine_evidence": true,
    "recent_competitive_load_policy_ref": "config/intelligence/competitive_load.json",
    "tactical_matchup_policy_ref": "config/intelligence/tactical_matchup.json"
  },
  "consensus": {
    "minimum_current_pundits": 2,
    "strong_consensus_ratio": 0.75,
    "simple_consensus_ratio": 0.5,
    "maximum_single_source_weight": 1.0,
    "freshness_hours": {
      "MODEL_CHALLENGER": 12,
      "FIXTURE_STRATEGY_EXPERT": 72,
      "PUNDIT_CONSENSUS": 48,
      "COMMUNITY_SIGNAL": 12,
      "VERIFIED_NEWS": 12
    }
  },
