{
  "schema_version": 1,
  "contract": "COMPETITIVE_LOAD_PRIMITIVE_V1",
  "owner": "reporting.competitive_load",
  "scope": {
    "materialize_all_canonical_players": true,
    "report_owned": 15,
    "report_watchlist": 20,
    "advisory_only": true
  },
  "states": ["RESTED", "NORMAL", "CONGESTED", "HIGH_ROTATION_RISK", "UNKNOWN"],
  "known_competitions": [
    "Premier League",
    "FA Cup",
    "EFL Cup",
    "UEFA Champions League",
    "UEFA Europa League",
    "UEFA Conference League",
    "Community Shield",
    "International",
    "Other official competitive first-team fixture"
  ],
  "classification": {
    "rested_min_hours": 144,
    "congested_rest_hours": 72,
    "high_rotation_rest_hours": 72,
    "high_rotation_minutes": 80,
    "extra_time_high_risk_rest_hours": 96,
    "congested_matches_7d": 2,
    "congested_matches_14d": 4
  },
  "optional_external_observation_contract": "COMPETITIVE_LOAD_OBSERVATIONS_V1",
  "governance": {
