{
  "version":8,
  "data_root":"data/v5",
  "artifacts":{
    "latest":"latest.json",
    "health":"health.json",
    "team":"team.json",
    "live":"live.json",
    "source_fusion":"source_fusion.json",
    "prices":"prices.json",
    "price_trajectory":"price_trajectory.json",
    "price_alerts":"price_alerts.json",
    "mini_league_tracking":"mini_league_tracking.json",
    "historical_prior":"historical_prior.json",
    "predictions":"predictions.json",
    "prediction_quality":"prediction_quality.json",
    "team_strength":"team_strength.json",
    "prediction_ledger":"prediction_ledger.json",
    "prediction_accuracy":"prediction_accuracy.json",
    "challenger_observations":"challenger_observations.json",
    "challenger_scorecard":"challenger_scorecard.json",
    "challenger_comparator":"challenger_comparator.json",
    "package_optimizer":"package_optimizer.json",
    "watchlist":"dss_watchlist.json",
    "framework_health":"framework_health.json",
    "decision":"decision.json",
    "user_report":"user_report.json",
    "technical_appendix":"technical_appendix.json",
    "report_state":"report_state.json",
    "replay_bundle":"replay_bundle.json",
    "decision_hot_bundle":"decision_hot_bundle.json",
    "history":"history.jsonl"
  },
  "gameweek":{"directory":"gw","filename_template":"{gw:02d}.json"},
  "write_policy":{
    "atomic_json":true,
    "append_history":true,
    "persist_raw_authenticated_payload":false,
    "separate_from_v3_v4_runtime_data":true,
    "do_not_overwrite_healthy_price_state_with_degraded_fallback":true,
    "decision_hot_bundle_requires_durable_write_before_memory_publish":true,
    "replay_bundle_contains_post_truth_inputs_only":true,
    "replay_bundle_forbids_raw_authenticated_payload":true
  }
}
