{
  "schema_version": 3,
  "registry": "V3_EXECUTION_DOMAINS_V2",
  "architecture": "V3_CANONICAL_DOMAIN_PIPELINE",
  "phase_count": 6,
  "domain_count": 11,
  "canonical_phases": {
    "ACQUIRE": [
      "official_state",
      "personal_team_state"
    ],
    "ENRICH": [
      "football_context",
      "market_context"
    ],
    "MODEL": [
      "prediction"
    ],
    "DECISION": [
      "squad_decision",
      "challenger_analysis"
    ],
    "GOVERNANCE": [
      "framework_governance",
      "prediction_validation"
    ],
    "PUBLISH": [
      "reporting",
      "serving"
    ]
  },
  "control_plane": {
    "compiler": "src.runtime_v3.registry_compiler",
    "compiled_registry": "V3_COMPILED_EXECUTION_PLAN_V1",
    "capability_contract_registry": "config/v3_service_registry.json",
    "module_batch_registry": "DERIVED_FROM_CAPABILITY_COMMANDS",
    "human_maintained_module_batch_registry": false,
    "artifact_writer_exceptions_fail_closed": true
  },
  "compatibility": {
    "previous_registry": "V3_EXECUTION_DOMAINS_V1",
    "previous_domain_count": 7,
    "business_capability_contract_unchanged": true,
    "service_registry_unchanged": false,
    "legacy_domain_aliases": {
      "ACQUIRE": [
        "official_state",
        "personal_team_state"
      ],
      "ENRICH": [
        "football_context"
      ],
      "MODEL": [
        "prediction"
      ],
      "MARKET": [
        "market_context"
      ],
      "DECISION": [
        "squad_decision",
        "challenger_analysis"
      ],
      "GOVERNANCE": [
        "framework_governance",
        "prediction_validation"
      ],
      "PUBLISH": [
        "reporting",
        "serving"
      ]
    }
  },
  "policy": {
    "capability_ownership_remains_in_v3_architecture_ownership_registry": true,
    "execution_domains_are_process_orchestration_boundaries_not_business_owners": true,
    "one_domain_run_may_execute_multiple_capability_modules": true,
    "shared_canonical_state_replaces_cross_service_copy_promotion_where_safe": true,
    "artifact_contract_validation_is_preserved": true,
    "gate0_and_dss_strictness_are_preserved": true,
    "official_network_ownership_is_preserved": true,
    "no_capability_is_removed_by_domain_grouping": true,
    "prediction_and_market_context_use_isolated_workspaces": true,
    "prediction_and_market_context_may_execute_in_parallel": true,
    "parallel_domain_fan_in_uses_declared_artifacts_and_latest_keys_only": true,
    "parallel_domain_fan_in_is_deterministic": true,
    "phase_membership_is_a_responsibility_taxonomy_not_a_strict_execution_barrier": true,
    "dependency_dag_controls_execution_order": true,
    "prediction_has_no_decision_or_reporting_ownership": true,
    "challenger_analysis_is_advisory_to_squad_decision": true,
    "prediction_validation_gates_publication": true,
    "reporting_and_serving_consume_one_governed_snapshot": true,
    "capability_registry_is_contract_catalog_not_process_count": true,
    "module_batches_are_derived_from_capability_commands": true,
    "duplicate_human_maintained_execution_truth_is_forbidden": true,
    "base_snapshot_declares_only_artifacts_it_actually_writes": true
  },
  "artifact_writer_exceptions": {
    "prices.json": {
      "kind": "base_market_state_then_market_enrichment",
      "writers": [
        "market_state",
        "price"
      ]
    },
    "user_report.json": {
      "kind": "report_then_serving_materialization",
      "writers": [
        "reporting",
        "report_materializer"
      ]
    }
  },
  "domains": {
    "official_state": {
      "phase": "ACQUIRE",
      "depends_on": [],
      "capabilities": [
        "official_snapshot",
        "rules"
      ]
    },
    "personal_team_state": {
      "phase": "ACQUIRE",
      "depends_on": [
        "official_state"
      ],
      "capabilities": [
        "team_state",
        "market_state",
        "live_state",
        "advanced_stats",
        "base_snapshot",
        "authenticated_official"
      ]
    },
    "football_context": {
      "phase": "ENRICH",
      "depends_on": [
        "personal_team_state"
      ],
      "capabilities": [
        "historical_prior",
        "tactical_context",
        "source_layer"
      ]
    },
    "market_context": {
      "phase": "ENRICH",
      "depends_on": [
        "football_context"
      ],
      "capabilities": [
        "price",
        "official_detail"
      ]
    },
    "prediction": {
      "phase": "MODEL",
      "depends_on": [
        "football_context"
      ],
      "capabilities": [
        "prediction"
      ]
    },
    "squad_decision": {
      "phase": "DECISION",
      "depends_on": [
        "prediction"
      ],
      "capabilities": [
        "lineup_governance"
      ]
    },
    "challenger_analysis": {
      "phase": "DECISION",
      "depends_on": [
        "prediction_validation",
        "football_context"
      ],
      "capabilities": [
        "challenger"
      ]
    },
    "framework_governance": {
      "phase": "GOVERNANCE",
      "depends_on": [
        "market_context",
        "prediction_validation",
        "squad_decision",
        "challenger_analysis"
      ],
      "capabilities": [
        "governance"
      ]
    },
    "prediction_validation": {
      "phase": "GOVERNANCE",
      "depends_on": [
        "prediction"
      ],
      "capabilities": [
        "prediction_evaluation"
      ]
    },
    "reporting": {
      "phase": "PUBLISH",
      "depends_on": [
        "framework_governance"
      ],
      "capabilities": [
        "watchlist",
        "reporting"
      ]
    },
    "serving": {
      "phase": "PUBLISH",
      "depends_on": [
        "reporting"
      ],
      "capabilities": [
        "report_materializer"
      ]
    }
  }
}
