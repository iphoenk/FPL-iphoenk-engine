{
  "schema_version": 2,
  "registry": "EXTERNAL_CHALLENGER_SCORECARD_V2",
  "auto_scrape": false,
  "structured_ingestion_is_registry_driven": true,
  "observation_contract": "challenger_observation_v2",
  "observation_file": "data/challenger_observations.json",
  "minimum_sample_for_dynamic_weight": 50,
  "providers": [
    {"id": "internal", "name": "FPL iphoenk Engine", "mode": "native", "enabled": true},
    {"id": "fffix", "name": "Fantasy Football Fix", "mode": "observation_file", "enabled": true},
    {"id": "ffhub", "name": "Fantasy Football Hub", "mode": "observation_file", "enabled": true},
    {
      "id": "fpl_tactics",
      "name": "FPL Tactics",
      "mode": "observation_file",
      "enabled": true,
      "authority": "ADVISORY_ONLY",
      "source_class": "MODEL_CHALLENGER",
      "root_family": "fpl_tactics_model",
      "domain": "fpltactics.com",
      "capabilities": ["xpts", "player_rating", "captain_rank", "transfer_stance"]
    },
    {
      "id": "fplratings",
      "name": "FPLRatings",
      "mode": "observation_file",
      "enabled": true,
      "authority": "DIAGNOSTIC_ONLY",
      "source_class": "DIAGNOSTIC_CHALLENGER",
      "root_family": "fplratings_model",
      "domain": "fplratings.com",
      "capabilities": ["rating", "form_delta", "regression_flag", "source_rank"]
    },
    {
      "id": "fplanaly",
      "name": "FPLAnaly",
      "mode": "observation_file",
      "enabled": true,
      "authority": "ADVISORY_ONLY",
      "source_class": "ANALYTICAL_CHALLENGER",
      "root_family": "fplanaly_model",
      "domain": "fplanaly.st",
      "capabilities": ["value", "set_piece", "form_context", "xpts"]
    }
  ],
  "supported_metrics": ["xpts", "xmins", "start_probability", "price_direction", "price_prediction", "player_rating", "captain_rank", "transfer_stance", "rating", "form_delta", "regression_flag", "source_rank", "value", "set_piece", "form_context"],
  "governance": {
    "missing_provider_data_is_not_fabricated": true,
    "provider_weight_requires_observed_accuracy": true,
    "provider_reputation_is_not_accuracy_evidence": true,
    "structured_price_context_never_overrides_official_price_fields": true,
    "cached_or_stale_structured_observations_are_not_current": true,
    "report_time_only_providers_are_excluded_from_machine_scorecard": true,
    "external_observations_never_mutate_canonical_predictions": true,
    "external_observations_never_mutate_canonical_captain": true,
    "official_fpl_derived_fields_are_not_independent": true,
    "root_family_is_the_independence_unit": true,
    "diagnostic_signals_are_not_direct_decisions": true
  }
}
