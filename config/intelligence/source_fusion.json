{
  "schema_version": 4,
  "model_id": "v5_source_fusion_v4",
  "source_registry": "config/sources/registry.json",
  "season_authority": {
    "registry_path": "config/rules/registry.json",
    "season_field": "season"
  },
  "source_runtime_projection": {
    "registry_path": "config/sources/registry.json",
    "runtime_field": "ingestion",
    "source_ids": ["understat", "api_football"],
    "credential_env_alias": "api_key_env"
  },
  "concurrency": {
    "max_workers_policy": "canonical_source_registry",
    "max_workers_field": "policy.max_workers"
  },
  "sources": {
    "understat": {
      "source_id": "understat",
      "collector": "src.v5.sources.understat.collect",
      "enablement_authority": "config/sources/registry.json"
    },
    "api_football": {
      "source_id": "api_football",
      "collector": "src.v5.sources.api_football.collect",
      "enablement_authority": "config/sources/registry.json"
    },
    "open_meteo": {
      "source_id": "open_meteo",
      "collector": "src.v5.sources.weather_open_meteo.collect",
      "enablement_authority": "config/sources/registry.json",
      "policy_ref": "config/intelligence/weather_context.json",
      "venue_registry_ref": "config/venues/premier_league_2026_27.json",
      "cache_path": "data/v5/source_cache/weather_open_meteo.json"
    }
  },
  "report_time_verified_news": {
    "enabled": true,
    "retrieval_owner": "REPORT_COMPOSER_WEB_PASS",
    "policy_ref": "config/intelligence/recent_competitive_load.json",
    "required_sweeps": ["press_conference_and_official_team_news", "latest_competitive_first_team_match_all_competitions"],
    "preferred_sources": ["official_club", "premierleague.com", "uefa.com", "efl.com", "thefa.com"],
    "decision_influence": "XMINS_ROTATION_CONFIDENCE_ONLY",
    "direct_xpts_mutation_forbidden": true,
    "collector_source_registry_mutation_forbidden": true
  },
  "governance": {
    "canonical_source_enablement_only": true,
    "runtime_configuration_is_projected_from_canonical_registry": true,
    "local_source_enabled_flags_forbidden": true,
    "weather_advisory_only": true,
    "missing_enrichment_is_unavailable_not_zero": true,
    "source_failure_is_fail_neutral_unless_critical": true,
    "network_fetch_owner": "ingestion",
    "report_time_verified_news_is_separate_from_collector_ingestion": true
  }
}
