{
  "schema_version": 11,
  "registry": "fpl_v4_9_6_microservice_registry_v11",
  "architecture_version": "4.9.6",
  "execution_model": "process_isolated_dag_parallel_single_host",
  "services": [
    {
      "id": "raw_snapshot",
      "name": "Raw Snapshot Service",
      "boundary_state": "INDEPENDENT",
      "module": "src.services.raw_snapshot_service",
      "command": ["{python}", "-m", "src.services.raw_snapshot_service", "{mode}"],
      "runtime_flags": {"as_of": "--as-of"},
      "timeout_seconds": 90,
      "depends_on": [],
      "produces": ["raw_snapshot"],
      "critical": true
    },
    {
      "id": "enrichment",
      "name": "Enrichment Service",
      "boundary_state": "INDEPENDENT",
      "module": "src.services.enrichment_service",
      "command": ["{python}", "-m", "src.services.enrichment_service"],
      "runtime_flags": {"stats": "--stats", "deep_stats": "--deep-stats"},
      "timeout_seconds": 90,
      "depends_on": ["raw_snapshot"],
      "produces": ["enrichment"],
      "critical": true
    },
    {
      "id": "prediction",
      "name": "Prediction Service",
      "boundary_state": "INDEPENDENT",
      "module": "src.services.prediction_service",
      "command": ["{python}", "-m", "src.services.prediction_service"],
      "timeout_seconds": 60,
      "depends_on": ["enrichment"],
      "produces": ["latest_snapshot", "predictions", "team_state", "universe", "source_health"],
      "critical": true
    },
    {
      "id": "validation",
      "name": "Validation & Preflight Assurance Service",
      "boundary_state": "INDEPENDENT",
      "module": "src.services.validation_service",
      "command": ["{python}", "-m", "src.services.validation_service"],
      "timeout_seconds": 45,
      "depends_on": ["prediction"],
      "produces": ["validation_lifecycle", "reconciliation_readiness", "compliance", "framework_preflight"],
      "critical": true
    },
    {
      "id": "optimization",
      "name": "Optimization & Decision Service",
      "boundary_state": "INDEPENDENT",
      "module": "src.services.optimization_slo_service",
      "command": ["{python}", "-m", "src.services.optimization_slo_service"],
      "timeout_seconds": 45,
      "depends_on": ["prediction"],
      "produces": ["wc_decision", "wc_package", "lineup", "recommendation_sanity", "decision_pipeline"],
      "critical": true
    },
    {
      "id": "user_decision_overlay",
      "name": "User Plan Authority Service",
      "boundary_state": "INDEPENDENT",
      "module": "src.services.user_decision_overlay_service",
      "command": ["{python}", "-m", "src.services.user_decision_overlay_service"],
      "timeout_seconds": 20,
      "depends_on": ["optimization"],
      "produces": ["effective_plan"],
      "critical": true
    },
    {
      "id": "personal_gw_scorecard",
      "name": "Personal GW Scorecard Service",
      "boundary_state": "INDEPENDENT",
      "module": "src.services.gw_scorecard_service",
      "command": ["{python}", "-m", "src.services.gw_scorecard_service"],
      "timeout_seconds": 20,
      "depends_on": ["user_decision_overlay"],
      "produces": ["gw_scorecard"],
      "critical": true
    },
    {
      "id": "governance",
      "name": "Postflight & Report Governance Service",
      "boundary_state": "INDEPENDENT",
      "module": "src.services.governance_service",
      "command": ["{python}", "-m", "src.services.governance_service"],
      "timeout_seconds": 30,
      "depends_on": ["validation", "user_decision_overlay", "personal_gw_scorecard"],
      "produces": ["framework_postflight", "checkpoint_decision"],
      "critical": true
    }
  ],
  "guardrails": {
    "official_fpl_api_authority": "raw_snapshot_only",
    "official_fpl_first_when_field_available": true,
    "services_may_not_refetch_snapshot": true,
    "validation_lifecycle_no_official_refetch": true,
    "deadline_snapshot_immutable": true,
    "retroactive_snapshot_rejected": true,
    "reconciliation_archive_immutable": true,
    "reconciliation_idempotent": true,
    "health_view_current_model_only": true,
    "reconciliation_started_from_official_stats_starts": true,
    "minutes_never_infer_started": true,
    "missing_starts_excluded_from_brier": true,
    "personal_gw_scorecard_no_official_refetch": true,
    "finished_gw_archive_immutable": true,
    "scorecard_simulation_never_mutates_archive": true,
    "scorecard_projection_from_effective_plan_contract": true,
    "user_decision_overlay_process_isolated": true,
    "engine_is_advisory": true,
    "user_decision_is_final_authority": true,
    "engine_never_auto_overwrites_valid_user_override": true,
    "effective_plan_legality_enforced_post_overlay": true,
    "projection_default_baseline_previous_submitted_gw": true,
    "planning_override_requires_target_gw": true,
    "stale_planning_override_rejected": true,
    "advanced_ablation_observational_outside_decision_chain": true,
    "advanced_ablation_full_shadow_parity_required": true,
    "advanced_ablation_failure_cannot_block_core_publish": true,
    "fail_closed_on_contract_failure": true,
    "lock_after_pass": ["raw_snapshot", "enrichment", "prediction"],
    "prediction_quality_inputs_consumed": true,
    "truthful_competition_evidence": true,
    "critical_warmup_blocks_unqualified_go": true,
    "optimizer_search_width_unchanged": true,
    "decision_compute_slo_ms": 5000,
    "decision_compute_slo_excludes_external_network_io": true,
    "dag_parallel_ready_services": true,
    "parallel_services_must_have_no_dependency_edge": true,
    "validation_and_optimization_may_parallelize_after_prediction": true,
    "governance_requires_validation_user_plan_and_scorecard": true,
    "human_report_language_governed": true,
    "technical_reason_codes_separate_from_human_report": true,
    "scheduled_checkpoint_recovery_enabled": true,
    "gate0_checks_unchanged": 16,
    "registry_counts_unchanged": {"dss_core": 50, "dss_extensions": 16, "enhancements": 8},
    "architecture_guard_runs_before_orchestration": true,
    "duplicate_service_ids_rejected": true,
    "duplicate_contract_producers_rejected": true,
    "duplicate_contract_paths_rejected": true,
    "duplicate_registry_ids_rejected": true,
    "canonical_rules_single_owner": true,
    "canonical_legality_single_implementation": true,
    "exact_nontrivial_function_clones_rejected": true,
    "reusable_production_workflow_single_owner": true,
    "release_manifest_single_source": true,
    "service_count": 8,
    "validation_boundary_preserves_four_artifact_contracts": true,
    "governance_boundary_preserves_postflight_and_checkpoint_contracts": true
  }
}
