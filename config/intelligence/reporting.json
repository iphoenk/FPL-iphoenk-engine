{
  "schema_version": 1,
  "model_id": "decision_first_report_v1",
  "layers": ["USER_REPORT", "TECHNICAL_APPENDIX"],
  "decision_states": ["HOLD", "CHANGE", "REVIEW"],
  "confidence_labels": ["HIGH", "MEDIUM", "LOW"],
  "lock_labels": ["LOCK", "LEAN", "OPEN"],
  "section_order": [
    "decision",
    "owned_squad",
    "changes_since_last_report",
    "starting_xi",
    "captaincy",
    "chip",
    "price_radar",
    "external_watchlist",
    "engine_line",
    "action_board"
  ],
  "stable_report": {
    "enabled": true,
    "compact_when_no_material_change": true,
    "normal_length_ratio_target": 0.35,
    "material_delta_keys": ["squad", "starting_xi", "captain", "vice_captain", "chip", "price", "critical_health"]
  },
  "starting_xi": {
    "lock_margin": 0.75,
    "high_confidence_margin": 1.25,
    "medium_confidence_margin": 0.50,
    "publish_full_xi_on_initial_report": true,
    "publish_full_xi_when_changed": true
  },
  "captaincy": {
    "minimum_start_probability_for_lock": 0.85,
    "minimum_expected_minutes_for_lock": 70.0,
    "maximum_dnp_probability_for_lock": 0.10,
    "maximum_relative_volatility_for_lock": 0.70,
    "minimum_score_margin_for_lock": 0.40,
    "require_role_evidence_for_lock": true,
    "required_role_fields_any": ["penalty_share", "penalty_role", "set_piece_share", "set_piece_role"],
    "require_positive_fixture_context": true,
    "missing_required_evidence_result": "OPEN"
  },
  "price_radar": {
    "owned_minimum_urgency": "HIGH",
    "external_requires_full_dss_watchlist": true,
    "allowed_urgencies": ["HIGH", "CRITICAL"],
    "show_market_noise": false,
    "translate_projection_health_to_plain_language": true
  },
  "watchlist": {
    "artifact": "data/dss_watchlist.json",
    "required_contract": "FULL_DSS_SCREEN_V1",
    "max_per_position": 5,
    "positions": ["GK", "DEF", "MID", "FWD"],
    "required_dimensions": [
      "role",
      "xmins",
      "fixtures_3_5",
      "underlying",
      "system_fit",
      "competition",
      "set_piece_penalty",
      "price_value",
      "squad_fit"
    ],
    "missing_or_incomplete_result": "INSUFFICIENT_EVIDENCE"
  },
  "action_board": {
    "max_items": 8,
    "allowed_actions": ["HOLD", "START", "BENCH", "LOCK", "LEAN", "OPEN", "WATCH", "BUY", "SELL", "REVIEW"]
  },
  "language": {
    "decision_first": true,
    "natural_fpl_language": true,
    "forbidden_user_report_tokens": ["go_allowed", "SUSPECT_STATIC_OFFSET0", "DSS-", "Gate 0", "epistemik", "asset-value protection"],
    "technical_terms_allowed_only_in_appendix": true
  },
  "governance": {
    "facts_models_decisions_separated": true,
    "raw_model_ranking_is_not_final_recommendation": true,
    "latest_gw_is_evidence_not_single_gw_decision_driver": true,
    "primary_horizon_gws": [3, 5],
    "strategic_horizon_gws": [10, 15],
    "technical_health_is_one_line_in_user_report_unless_critical": true,
    "missing_external_evidence_is_never_fabricated": true
  }
}
