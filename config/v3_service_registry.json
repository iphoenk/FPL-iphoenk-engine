{
  "schema_version": 10,
  "architecture": "V3_BOUNDED_PROCESS_MICROSERVICES",
  "production_contract": "v3.19-report-time-intelligence-15-owned-20-watchlist",
  "transport": "isolated-filesystem-contract",
  "policy": {
    "coarse_grained_services": true,
    "single_run_shared_official_cache": true,
    "parallelize_independent_services": true,
    "service_data_isolation": true,
    "deterministic_fan_in": true,
    "no_business_logic_rewrite_required": true,
    "fail_closed_on_critical_service_failure": true,
    "latest_json_single_writer_during_fan_in": true,
    "dependency_aware_scheduling": true,
    "raw_optimizer_is_not_final_decision": true,
    "postflight_gate0_requires_governed_lineup_and_package": true,
    "mechanical_validity_is_not_prediction_quality": true,
    "historical_prior_missing_evidence_is_never_fabricated": true,
    "two_layer_report_contract": true,
    "user_report_is_decision_first": true,
    "technical_state_is_appendix_only": true,
    "full_dss_watchlist_generator": true,
    "watchlist_requires_postflight_framework_state": true,
    "report_materializer_is_serving_only": true,
    "report_serving_requires_15_owned_and_20_external_watchlist": true,
    "technical_and_full_source_artifacts_are_lazy_load": true,
    "source_registry_is_separate_infrastructure_layer": true,
    "official_fpl_remains_native_authority": true,
    "challenger_source_failure_does_not_block_decisions": true,
    "missing_external_observations_are_never_fabricated": true,
    "dss_module_health_is_separate_from_signal_availability": true,
    "all_active_dss_requires_runtime_evidence_contract": true,
    "strict_postflight_requires_50_core_16_extensions_and_8_enhancements_active": true,
    "source_reachability_is_separate_from_capability_data_health": true,
    "structured_challenger_ingestion_is_registry_driven": true,
    "price_challenger_context_is_non_authoritative": true,
    "stale_challenger_observations_are_not_current": true,
    "version_neutral_service_entrypoints": true,
    "inline_python_service_commands_forbidden": true,
    "framework_expected_counts_are_registry_owned": true,
    "report_time_source_registry_is_separate_from_machine_source_registry": true,
    "onefpl_unattended_collector_fetch_is_disabled": true,
    "report_time_sources_never_mutate_dss": true,
    "pundit_consensus_is_advisory_only": true,
    "pundit_consensus_is_compared_with_dss": true,
    "community_signal_requires_crosscheck": true,
    "fixture_strategy_expert_does_not_vote_on_player_projection": true,
    "report_time_web_refresh_is_chat_report_orchestration_owned": true
  },
  "runtime": {
    "max_parallel_services": 5,
    "service_timeout_seconds": 180,
    "http_cache_ttl_seconds": 180,
    "performance_budget_seconds": 45,
    "performance_target": "preserve sub-45-second unattended runtime while report-time web intelligence stays outside collector I/O and full DSS operational evidence remains green"
  },
  "services": {
    "collector": {
      "stage": "base",
      "depends_on": [],
      "critical": true,
      "isolated": false,
      "commands": [
        {"module": "src.engine", "args": ["{mode}", "{stats}", "{deep_stats}"]},
        {"module": "src.reliability_overlay", "args": []}
      ]
    },
    "source_layer": {
      "stage": "parallel",
      "depends_on": ["collector"],
      "critical": true,
      "isolated": true,
      "inputs": [
        "latest.json", "health.json", "challenger_observations.json", "stats/shots_gw1.json", "stats/playermatchstats_gw1.json",
        "stats/vaastav_previous_season.json"
      ],
      "commands": [{"module": "src.engines.source_layer", "args": []}],
      "artifacts": ["source_health.json", "source_registry_runtime.json", "challenger_observations.json"],
      "latest_keys": ["source_layer_summary"],
      "latest_file_keys": ["source_health", "source_registry_runtime", "challenger_observations"]
    },
    "price": {
      "stage": "parallel",
      "depends_on": ["collector", "source_layer"],
      "critical": true,
      "isolated": true,
      "inputs": ["latest.json", "team.json", "prices.json", "price_trajectory.json", "challenger_observations.json"],
      "commands": [{"module": "src.engines.price_service", "args": []}],
      "artifacts": ["prices.json", "price_trajectory.json", "price_alerts.json", "price_challenger_context.json"],
      "latest_keys": ["price_summary"],
      "latest_file_keys": ["price_trajectory", "price_alerts", "price_challenger_context"]
    },
    "historical_prior": {
      "stage": "parallel",
      "depends_on": ["collector"],
      "critical": true,
      "isolated": true,
      "inputs": ["latest.json", "stats/vaastav_previous_season.json"],
      "commands": [{"module": "src.engines.historical_prior_service", "args": []}],
      "artifacts": ["prior_season.json", "stats/vaastav_previous_season.json"],
      "latest_keys": ["historical_prior_summary"],
      "latest_file_keys": ["prior_season", "vaastav_previous_season"]
    },
    "prediction": {
      "stage": "parallel",
      "depends_on": ["historical_prior"],
      "critical": true,
      "isolated": true,
      "inputs": ["latest.json", "team.json", "prior_season.json"],
      "commands": [{"module": "src.engines.prediction_service", "args": []}],
      "artifacts": ["team_strength.json", "projections.json", "package_optimizer.json", "prediction_quality.json"],
      "latest_keys": ["decision_intelligence", "prediction_quality_summary"],
      "latest_file_keys": ["team_strength", "projections", "package_optimizer", "prediction_quality"]
    },
    "authenticated_official": {
      "stage": "parallel",
      "depends_on": ["collector"],
      "critical": true,
      "isolated": true,
      "inputs": ["latest.json", "team.json"],
      "commands": [{"module": "src.engines.authenticated_official", "args": []}],
      "artifacts": ["auth.json"],
      "latest_keys": ["authenticated_official"],
      "latest_file_keys": ["auth"]
    },
    "rules": {
      "stage": "parallel",
      "depends_on": ["collector"],
      "critical": true,
      "isolated": true,
      "inputs": [],
      "commands": [{"module": "src.engines.rules_compliance_audit", "args": []}],
      "artifacts": ["rules_compliance.json"],
      "latest_keys": [],
      "latest_file_keys": []
    },
    "official_detail": {
      "stage": "parallel",
      "depends_on": ["price"],
      "critical": true,
      "isolated": true,
      "inputs": ["latest.json", "team.json", "prices.json"],
      "commands": [{"module": "src.engines.official_expansion", "args": []}],
      "artifacts": ["official_detail.json"],
      "latest_keys": ["official_detail_summary", "official_health_panel"],
      "latest_file_keys": []
    },
    "prediction_evaluation": {
      "stage": "parallel",
      "depends_on": ["prediction"],
      "critical": true,
      "isolated": true,
      "inputs": ["latest.json", "projections.json", "prediction_ledger.json"],
      "commands": [{"module": "src.engines.prediction_evaluation", "args": []}],
      "artifacts": ["prediction_ledger.json", "prediction_accuracy.json"],
      "latest_keys": ["prediction_evaluation"],
      "latest_file_keys": ["prediction_ledger", "prediction_accuracy"]
    },
    "lineup_governance": {
      "stage": "governed-decision",
      "depends_on": ["prediction"],
      "critical": true,
      "isolated": true,
      "inputs": ["latest.json", "team.json", "chips.json", "projections.json", "package_optimizer.json"],
      "commands": [{"module": "src.engines.lineup_governance", "args": []}],
      "artifacts": ["lineup_decision.json", "package_decision.json"],
      "latest_keys": ["lineup_decision_summary", "package_decision_summary"],
      "latest_file_keys": ["lineup_decision", "package_decision"]
    },
    "challenger": {
      "stage": "parallel",
      "depends_on": ["prediction_evaluation", "source_layer"],
      "critical": true,
      "isolated": true,
      "inputs": ["latest.json", "projections.json", "prediction_ledger.json", "challenger_observations.json", "source_health.json"],
      "commands": [{"module": "src.engines.challenger_scorecard", "args": []}],
      "artifacts": ["challenger_scorecard.json"],
      "latest_keys": ["challenger_scorecard"],
      "latest_file_keys": ["challenger_scorecard"]
    },
    "governance": {
      "stage": "final",
      "depends_on": ["source_layer", "price", "prediction", "authenticated_official", "rules", "official_detail", "prediction_evaluation", "lineup_governance", "challenger"],
      "critical": true,
      "isolated": false,
      "commands": [
        {"module": "src.engines.framework_health_service", "args": ["--phase", "preflight", "--strict"]},
        {"module": "src.engines.framework_health_service", "args": ["--phase", "postflight", "--strict"]},
        {"module": "src.engines.p0_framework_health_overlay", "args": []},
        {"module": "src.engines.lineup_framework_health_overlay", "args": []},
        {"module": "src.engines.decision_quality_overlay", "args": []},
        {"module": "src.engines.source_framework_overlay", "args": []},
        {"module": "src.engines.dss_operationalization_overlay", "args": []}
      ]
    },
    "watchlist": {
      "stage": "decision-output",
      "depends_on": ["governance"],
      "critical": true,
      "isolated": true,
      "inputs": [
        "latest.json", "team.json", "projections.json", "package_optimizer.json", "prices.json",
        "price_alerts.json", "framework_health.json", "dss_watchlist.json"
      ],
      "commands": [
        {"module": "src.engines.dss_watchlist", "args": []},
        {"module": "src.engines.watchlist_public_sanitize", "args": []}
      ],
      "artifacts": ["dss_watchlist.json"],
      "latest_keys": ["dss_watchlist_summary"],
      "latest_file_keys": ["dss_watchlist"]
    },
    "reporting": {
      "stage": "decision-output",
      "depends_on": ["watchlist"],
      "critical": true,
      "isolated": true,
      "inputs": [
        "latest.json", "team.json", "lineup_decision.json", "package_decision.json", "projections.json",
        "price_alerts.json", "prediction_quality.json", "framework_health.json", "challenger_scorecard.json",
        "report_state.json", "dss_watchlist.json", "source_health.json", "dss_operational_evidence.json"
      ],
      "commands": [
        {"module": "src.engines.report_architecture", "args": []},
        {"module": "src.engines.report_enrichment", "args": []}
      ],
      "artifacts": ["user_report.json", "technical_appendix.json", "report_state.json"],
      "latest_keys": ["report_summary"],
      "latest_file_keys": ["user_report", "technical_appendix", "report_state"]
    },
    "report_materializer": {
      "stage": "serving-output",
      "depends_on": ["reporting", "official_detail"],
      "critical": true,
      "isolated": true,
      "inputs": [
        "latest.json", "user_report.json", "technical_appendix.json", "team.json", "projections.json",
        "dss_watchlist.json", "official_detail.json", "source_health.json"
      ],
      "commands": [
        {"module": "src.engines.report_materializer", "args": []},
        {"module": "src.engines.report_serving_validate", "args": []}
      ],
      "artifacts": [
        "user_report.json", "decision_brief.json", "deep_review_payload.json", "dss_watchlist_summary.json",
        "official_detail_owned.json", "official_detail_watchlist.json", "report_artifact_registry.json"
      ],
      "latest_keys": ["report_serving"],
      "latest_file_keys": [
        "user_report", "decision_brief", "deep_review_payload", "dss_watchlist_summary",
        "official_detail_owned", "official_detail_watchlist", "report_artifact_registry"
      ]
    }
  }
}
