    "engine_recommendation_preserved_for_comparison": true,
    "lineup_legality_fail_closed": true,
    "captain_and_vice_must_be_distinct_xi_members": true,
    "post_deadline_official_submission_reclaims_authority": true
  },
  "reconciliation": {
    "enabled": true,
    "compare_by": "element_id",
    "submitted_becomes_baseline_after_deadline": true,
    "record_additions_removals": true
  }
}
