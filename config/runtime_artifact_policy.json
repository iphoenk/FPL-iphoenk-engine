{
  "schema_version": 1,
  "registry": "v4_runtime_artifact_authority_v1",
  "source_branch": {
    "branch": "v4-prediction-engine",
    "role": "code_config_tests_and_seed_material_only",
    "mutable_runtime_freshness_authority": false
  },
  "runtime_branch": {
    "branch": "runtime-data-v4",
    "role": "atomic_materialized_runtime_snapshot",
    "mutable_runtime_freshness_authority": true,
    "publication_mode": "orphan_atomic_replace"
  },
  "artifact_classes": {
    "source_seed": {
      "allowed_in_source_branch": true,
      "may_prove_current_runtime_freshness": false
    },
    "test_fixture": {
      "allowed_in_source_branch": true,
      "may_prove_current_runtime_freshness": false
    },
    "runtime_materialization": {
      "allowed_in_source_branch_as_seed_only": true,
      "current_authority_branch": "runtime-data-v4",
      "freshness_must_be_proven_by_runtime_metadata": true
    },
    "immutable_validation_archive": {
      "allowed_in_source_branch": true,
      "must_not_be_mutated_by_live_serving": true
    }
  },
  "guardrails": {
    "file_exists_is_not_freshness_proof": true,
    "source_seed_cannot_override_runtime_snapshot": true,
    "runtime_publish_is_atomic_branch_replace": true,
    "runtime_worktree_contains_data_only": true,
    "mutable_runtime_cache_directory_ignored": "data/runtime/"
  }
}
