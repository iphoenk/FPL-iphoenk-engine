{
  "version": 2,
  "default_operation": "build",
  "network_contract": {
    "return_full_predictions_by_default": false,
    "full_provenance_omitted": true,
    "player_fields": [
      "element",
      "name",
      "team_id",
      "position",
      "now_cost",
      "status",
      "ownership_pct",
      "current_season",
      "historical_prior",
      "xmins",
      "role",
      "xpts_by_gw",
      "horizons",
      "xpts_3",
      "xpts_5",
      "xpts_10",
      "xpts_15",
      "mean_xpts",
      "uncertainty",
      "fixtures",
      "projection_confidence",
      "advanced",
      "tactical_matchup"
    ],
    "required_player_fields": [
      "element",
      "name",
      "position",
      "xmins",
      "xpts_by_gw",
      "horizons",
      "xpts_3",
      "xpts_5",
      "xpts_10",
      "xpts_15",
      "mean_xpts",
      "uncertainty",
      "fixtures"
    ],
    "fixture_count": 5,
    "fixture_fields": [
      "event",
      "xpts",
      "lower80",
      "upper80",
      "xmins"
    ]
  },
  "performance": {
    "purpose": "bound prediction transport at the service boundary without mutating projection intelligence",
    "parallel_safe": true
  },
  "governance": {
    "single_network_contract_authority": true,
    "projection_core_transport_agnostic": true,
    "missing_or_invalid_contract_fails_closed": true
  }
}
