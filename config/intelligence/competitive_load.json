{
  "schema_version": 3,
  "contract": "COMPETITIVE_LOAD_PRIMITIVE_V1",
  "owner": "governance.competitive_load",
  "scope": {
    "materialize_all_canonical_players": true,
    "report_owned": 15,
    "report_watchlist": 20,
    "advisory_only": true,
    "mandatory_before_visible_report": true,
    "mandatory_on_deadline_day": true
  },
  "states": ["RESTED", "NORMAL", "CONGESTED", "HIGH_ROTATION_RISK", "UNKNOWN"],
  "known_competitions": [
    "Premier League",
    "FA Cup",
    "EFL Cup",
    "UEFA Champions League",
    "UEFA Europa League",
    "UEFA Conference League",
    "Community Shield",
    "International",
    "Other official competitive first-team fixture"
  ],
  "source_precedence": [
    "official_club_match_report_or_lineup",
    "official_competition_match_centre",
    "official_national_team_match_centre",
    "Premier League_or_Official_FPL",
    "reliable_direct_manager_or_team_news",
    "pundit_or_community_crosscheck_only"
  ],
  "observation_validation": {
    "contract": "COMPETITIVE_LOAD_OBSERVATIONS_V1",
    "retention_hours": 504,
    "future_tolerance_minutes": 10,
    "max_minutes": 130,
    "max_extra_time_minutes": 30,
    "require_source_url": true,
    "allowed_verification_levels": [
      "OFFICIAL_CLUB",
      "OFFICIAL_COMPETITION",
      "OFFICIAL_NATIONAL_TEAM",
      "CROSSCHECKED_OFFICIAL"
    ],
    "allowed_travel_contexts": [
      "HOME",
      "DOMESTIC_AWAY",
      "EUROPEAN_AWAY",
      "INTERNATIONAL_AWAY",
      "LONG_HAUL_AWAY",
      "NEUTRAL_VENUE",
      "UNKNOWN"
    ],
    "dedup_key": ["element", "competition", "match_time"],
    "invalid_rows_are_rejected_not_coerced": true,
    "stale_rows_do_not_affect_current_load": true,
    "future_rows_do_not_affect_current_load": true
  },
  "report_time_handoff": {
    "input_artifact": "data/competitive_load_observations.json",
    "producer": "REPORT_TIME_VERIFIED_EVIDENCE",
    "runtime_hydrate_and_republish": true,
    "official_or_crosschecked_official_only": true,
    "machine_scraper_not_required": true,
    "empty_or_missing_input_is_fail_soft": true,
    "invalid_observation_is_fail_soft_but_audited": true,
    "never_upgrade_coverage_from_unverified_evidence": true
  },
  "mandatory_player_fields": [
    "competition",
    "match_time",
    "started",
    "minutes",
    "sub_on_minute",
    "sub_off_minute",
    "position_or_role",
    "goal_or_assist",
    "set_piece_or_penalty_role_if_observed",
    "knock_or_injury_signal",
    "extra_time_minutes",
    "travel_context",
    "rest_hours_to_next_fixture"
  ],
  "press_conference_fields": [
    "manager_quote_or_official_team_news",
    "availability",
    "rotation_hint",
    "fitness_or_knock",
    "role_or_position_hint",
    "expected_return_timing_if_relevant"
  ],
  "classification": {
    "rested_min_hours": 144,
    "congested_rest_hours": 72,
    "high_rotation_rest_hours": 72,
    "high_rotation_minutes": 80,
    "extra_time_high_risk_rest_hours": 96,
    "congested_matches_7d": 2,
    "congested_matches_14d": 4
  },
  "xmins_handoff": {
    "enabled": true,
    "application": "REPORT_TIME_EVIDENCE_HANDOFF_ONLY",
    "direct_xpts_mutation_forbidden": true,
    "direct_xmins_model_mutation_forbidden_until_calibrated": true,
    "allowed_targets": [
      "manager_start_probability",
      "rotation_risk",
      "congestion_factor",
      "availability_challenge",
      "xmins_confidence"
    ],
    "rules": {
      "started_60plus_with_rest_under_72h": {
        "rotation_risk_delta": 0.12,
        "congestion_factor_cap": 0.94
      },
      "started_80plus_with_rest_under_72h": {
        "rotation_risk_delta": 0.18,
        "congestion_factor_cap": 0.90
      },
      "played_extra_time_with_rest_under_96h": {
        "rotation_risk_delta": 0.10,
        "congestion_factor_cap": 0.92
      },
      "unused_or_short_bench_with_rest_under_72h": {
        "rotation_risk_delta": -0.05,
        "congestion_factor_floor": 0.98
      },
      "verified_manager_positive_availability": {
        "manager_start_probability_floor": 0.78
      },
      "verified_manager_rotation_warning": {
        "rotation_risk_delta": 0.15
      },
      "verified_manager_doubt_or_knock": {
        "availability_review_required": true,
        "confidence_ceiling": "MEDIUM"
      }
    },
    "clamps": {
      "rotation_risk": [0.0, 1.0],
      "congestion_factor": [0.75, 1.0],
      "manager_start_probability": [0.01, 0.99]
    },
    "double_count_guard": "same physical load signal may affect xMins evidence once only"
  },
  "optional_external_observation_contract": "COMPETITIVE_LOAD_OBSERVATIONS_V1",
  "reporting": {
    "must_state_if_press_conference_coverage_incomplete": true,
    "must_state_if_last_competitive_match_not_verified": true,
    "must_surface_material_player_deltas": true,
    "technical_tokens_hidden_from_user_report": true
  },
  "governance": {
    "official_fpl_pl_fixture_facts_are_native": true,
    "verified_facts_outrank_models": true,
    "non_pl_competitions_require_verified_materialized_observation": true,
    "missing_non_pl_evidence_is_explicit": true,
    "report_time_pundit_or_community_never_becomes_fact_without_crosscheck": true,
    "no_blanket_fatigue_penalty": true,
    "direct_xpts_mutation_forbidden": true,
    "direct_xmins_mutation_forbidden_until_calibrated": true,
    "allowed_use": ["evidence", "confidence", "tie_breaker", "rotation_review"],
    "coach_rotation_tendency_must_not_be_inferred_without_evidence": true,
    "travel_distance_must_not_be_invented": true,
    "one_match_does_not_create_buy_or_sell": true,
    "recent_match_load_is_xmins_evidence_not_direct_points_evidence": true,
    "external_observation_validation_is_fail_closed_per_row": true,
    "external_observation_file_missing_is_fail_soft": true,
    "verification_provenance_is_required_for_non_pl_load": true
  }
}
