{
  "schema_version": 1,
  "registry": "V3_LOGIC_OWNERSHIP_V1",
  "policy": {
    "service_command_module_has_single_runtime_owner": true,
    "standard_official_network_fetch_has_explicit_owner": true,
    "decision_and_evaluation_layers_consume_artifacts_not_standard_official_network": true,
    "bundle_modules_are_orchestration_only": true,
    "bundle_modules_must_not_duplicate_business_formulas": true,
    "version_stamped_modules_are_not_active_runtime_owners": true,
    "microservice_boundaries_follow_artifact_and_failure_ownership": true,
    "file_size_alone_does_not_define_monolith": true,
    "policy_thresholds_belong_in_config_or_rules": true
  },
  "approved_direct_official_fetch_modules": [
    "src.engines.official_snapshot_service",
    "src.engines.official_expansion"
  ],
  "forbidden_direct_official_fetch_service_stages": [
    "parallel",
    "governed-decision",
    "final",
    "decision-output",
    "serving-output"
  ],
  "bundle_forbidden_tokens": [
    "src.sources.official_fpl",
    "requests.",
    "GOAL_POINTS",
    "ASSIST_POINTS",
    "SAVE_INTERVAL",
    "def score_",
    "def project_",
    "def optimise_",
    "def optimize_"
  ],
  "max_declared_commands_per_logical_service": 8,
  "notes": {
    "official_detail": "official_expansion is the explicit expensive/broad Official detail owner; it is separate from the standard snapshot owner by failure and latency semantics",
    "authenticated_official": "private authorized reads use the dedicated official_auth transport and are not standard public Official fetch duplication",
    "bundles": "FAST bundles may call existing service-stage functions in process but may not define a second football formula or source authority"
  }
}
