{
  "schema_version": 2,
  "model_id": "official_price_radar_v2",
  "deadline_timezone": "Europe/London",
  "market_filter": {
    "minimum_ownership_pct": 0.5,
    "minimum_abs_net_transfers": 5000,
    "high_confidence_abs_net_transfers": 25000
  },
  "trajectory": {
    "minimum_rate_pct_per_hour": 0.01,
    "risk_progress_floor_pct": 5.0,
    "maximum_eta_hours": 168,
    "trend_delta_pct_per_hour": 0.05,
    "static_projection_min_rate_pct_per_hour": 0.25,
    "static_projection_min_hours_to_deadline": 1.0,
    "static_projection_tolerance_pct": 0.05
  },
  "urgency": {
    "critical_progress_pct": 90,
    "high_progress_pct": 75,
    "medium_progress_pct": 50,
    "critical_hours": 24,
    "high_hours": 24,
    "medium_hours": 48,
    "actionable_progress_pct": 50,
    "alert_levels": ["CRITICAL", "HIGH"]
  },
  "calibration": {
    "max_events": 250,
    "miss_grace_hours": 12,
    "minimum_samples_for_calibrated_health": 20,
    "healthy_direction_accuracy": 0.7,
    "warning_direction_accuracy": 0.55,
    "suspect_static_ratio_warning": 0.5,
    "timing_error_warning_hours": 24
  },
  "serving": {
    "market_watch_capacity": 50,
    "alert_summary_size": 20
  },
  "governance": {
    "official_native_fields_are_authoritative": true,
    "price_signal_is_overlay": true,
    "challenger_context_cannot_override_official_fields": true,
    "direction_and_timing_health_are_separate": true,
    "price_change_observation_time_is_not_exact_change_time": true,
    "calibration_history_is_bounded": true
  }
}
