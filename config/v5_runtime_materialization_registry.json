{
  "schema_version": 1,
  "contract": "V5_RUNTIME_MATERIALIZATION_V1",
  "enabled": true,
  "max_entries": 32,
  "eviction_policy": "lru",
  "artifacts": {
    "predictions": {"cache_on_write": true, "serve_from_memory": true},
    "report_state": {"cache_on_write": true, "serve_from_memory": true},
    "price_trajectory": {"cache_on_write": true, "serve_from_memory": true},
    "historical_prior": {"cache_on_write": true, "serve_from_memory": true},
    "prediction_ledger": {"cache_on_write": true, "serve_from_memory": true},
    "challenger_observations": {"cache_on_write": true, "serve_from_memory": true}
  },
  "governance": {
    "durable_store_remains_authoritative": true,
    "durable_write_must_complete_before_cache_publish": true,
    "cache_miss_falls_back_to_durable_store": true,
    "cache_never_persists_credentials": true,
    "cache_is_process_local_to_snapshot_service": true,
    "cache_does_not_change_artifact_contract": true
  }
}
