{
  "schema_version": 1,
  "authority": "FPL_V12_P1_PRIVATE_PLANE",
  "classes": {
    "PUBLIC_FACT": {
      "description": "Unauthenticated facts reproducible by the public at the same effective time.",
      "examples": ["fixtures", "bootstrap_static", "public_submitted_picks_after_disclosure", "match_events"]
    },
    "PUBLIC_OPERATIONAL_PROOF": {
      "description": "Allowlisted execution metadata that contains no personal or decision state.",
      "examples": ["run_id", "report_mode", "report_slot", "status", "elapsed_seconds", "safe_fingerprint", "model_sha", "runtime_sha"]
    },
    "PRIVATE_PERSONAL": {
      "description": "Owner-specific current state or inputs that are not public factual authority.",
      "examples": ["current_private_squad", "bank", "free_transfers", "purchase_price", "selling_price", "pending_transfer", "manual_capture", "auth_state"]
    },
    "PRIVATE_DECISION": {
      "description": "Decision outputs, route materialization, tactical selections, or scenario results.",
      "examples": ["selected_route", "out_to_in", "stage3_action", "starting_xi", "bench", "captain", "vice", "chip", "staging", "scenario"]
    },
    "SECRET": {
      "description": "Credential material.",
      "examples": ["token", "cookie", "password", "authorization_header", "session"]
    }
  },
  "public_proof_allowed_fields": [
    "report_mode",
    "report_slot",
    "run_id",
    "analytics_status",
    "pre_render_status",
    "post_render_status",
    "human_facing_status",
    "stage3_validation_status",
    "model_sha",
    "runtime_sha",
    "safe_fingerprints",
    "private_delivery_status",
    "private_receipt_hash",
    "timing",
    "profile_mode"
  ],
  "public_proof_forbidden_semantic_keys": [
    "action",
    "stage3_action",
    "selected_route",
    "selected_route_id",
    "final_judgement",
    "transfer",
    "out",
    "in",
    "starting_xi",
    "bench",
    "captain",
    "vice",
    "vice_captain",
    "chip",
    "staging_rows",
    "scenario",
    "bank",
    "selling_price",
    "purchase_price",
    "free_transfers",
    "pending_transfer",
    "current_team",
    "auth_state",
    "cookie",
    "authorization",
    "token"
  ],
  "public_issue_proof_rule": {
    "stage3_field": "stage3_validation",
    "allowed_stage3_values": ["PASS", "FAIL", "NOT_APPLICABLE", "UNKNOWN"],
    "decision_action_allowed": false
  },
  "cache_target_classification": {
    "stage2_derived": "PUBLIC_SAFE",
    "p17_decision_core": "PRIVATE_REQUIRED",
    "mc_simulation_summary": "PRIVATE_REQUIRED"
  }
}
