{
  "version": 7,
  "data_root": "data/v5",
  "artifacts": {
    "latest": "latest.json",
    "health": "health.json",
    "team": "team.json",
    "live": "live.json",
    "source_fusion": "source_fusion.json",
    "prices": "prices.json",
    "price_trajectory": "price_trajectory.json",
    "price_alerts": "price_alerts.json",
    "historical_prior": "historical_prior.json",
    "predictions": "predictions.json",
    "prediction_quality": "prediction_quality.json",
    "team_strength": "team_strength.json",
    "competitive_load": "recent_competitive_load.json",
    "prediction_ledger": "prediction_ledger.json",
    "prediction_accuracy": "prediction_accuracy.json",
    "decision_validation_snapshots": "decision_validation_snapshots.json",
    "challenger_observations": "challenger_observations.json",
    "challenger_scorecard": "challenger_scorecard.json",
    "external_consensus": "external_consensus.json",
    "owned_challenger_comparator": "owned_challenger_comparator.json",
    "package_optimizer": "package_optimizer.json",
    "watchlist": "dss_watchlist.json",
    "framework_health": "framework_health.json",
    "decision": "decision.json",
    "user_report": "user_report.json",
    "technical_appendix": "technical_appendix.json",
    "report_state": "report_state.json",
    "history": "history.jsonl"
  },
  "gameweek": {
    "directory": "gw",
    "filename_template": "{gw:02d}.json"
  },
  "write_policy": {
    "atomic_json": true,
    "append_history": true,
    "persist_raw_authenticated_payload": false,
    "separate_from_v3_v4_runtime_data": true,
    "do_not_overwrite_healthy_price_state_with_degraded_fallback": true,
    "history_retention": {
      "canonical_evidence": false,
      "max_age_days": 14,
      "max_records": 128,
      "max_bytes": 33554432,
      "preserve_newest_record": false
    }
  },
  "evidence_storage": {
    "canonical_prediction_ledger": "prediction_ledger.json",
    "canonical_prediction_ledger_retention": "CURRENT_2026_27_SEASON",
    "gameweek_snapshot_retention": "CURRENT_2026_27_SEASON",
    "compact_analytics_mart_retention": "CURRENT_2026_27_SEASON",
    "raw_actions_artifact_retention_days": 14,
    "postseason_review_window_days": 90,
    "external_dwh_required_now": false,
    "external_dwh_trigger": "MULTI_SEASON_OR_GT_100000_PLAYER_GW_FACT_ROWS",
    "history_jsonl_is_canonical": false
  }
}
